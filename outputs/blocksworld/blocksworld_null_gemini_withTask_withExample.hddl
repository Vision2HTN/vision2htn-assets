(define (domain Blocks4)
  (:requirements :hierarchy :strips :typing :equality :negative-preconditions)
  
  (:types 
    block
  )

  (:predicates
    (on-table ?b - block)
    (on ?b1 - block ?b2 - block)
    (clear ?b - block)
    (hand-empty)
    (holding ?b - block)
  )

  ; -----------------------------------------------------------------------
  ; TASKS
  ; -----------------------------------------------------------------------

  (:task t-Make-On-Table ; ROOT TASK
    ; Evidence: Motivated by the goal of moving a block to the table.
    ; Generalisation: Applies to any target block ?block regardless of current configuration.
    :parameters (?block - block)
  )

  (:task t-Make-On ; ROOT TASK
    ; Evidence: Motivated by the goal of stacking one block onto another.
    ; Generalisation: Lifted to handle any distinct pair of blocks in the domain.
    :parameters (?above - block ?below - block)
  )

  (:task t-Make-Clear
    ; Evidence: Motivated by the need to remove obstructing blocks before a move.
    ; Generalisation: Plausible recursive abstraction to handle arbitrarily high stacks.
    :parameters (?b - block)
  )

  ; -----------------------------------------------------------------------
  ; METHODS
  ; -----------------------------------------------------------------------

  (:method m-Make-On-Table-Done
    ; Evidence: If block is already on table, do nothing.
    ; Generalisation: Strong evidence; base case for the goal.
    :parameters (?b - block)
    :task (t-Make-On-Table ?b)
    :precondition (on-table ?b)
    :subtasks ()
  )

  (:method m-Make-On-Table-From-Block
    ; Evidence: Moving a block from atop another block down to the table.
    ; Generalisation: Clears the block first to ensure safe unstacking from any arbitrary depth.
    :parameters (?b - block ?under - block)
    :task (t-Make-On-Table ?b)
    :precondition (on ?b ?under)
    :ordered-subtasks (and
      (t-Make-Clear ?b)
      (Unstack ?b ?under)
      (Putdown ?b)
    )
  )

  (:method m-Make-On-Done
    ; Evidence: Stacking goal is already met.
    ; Generalisation: Strong evidence; base case ensuring planner termination.
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (on ?above ?below)
    :subtasks ()
  )

  (:method m-Make-On-From-Table
    ; Evidence: Picking a block from the table and stacking it onto another.
    ; Generalisation: Ensures both blocks are safely cleared first, generalizing to cluttered states.
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (and 
      (on-table ?above) 
      (not (= ?above ?below))
    )
    :ordered-subtasks (and
      (t-Make-Clear ?above)
      (t-Make-Clear ?below)
      (Pickup ?above)
      (Stack ?above ?below)
    )
  )

  (:method m-Make-On-From-Block
    ; Evidence: Moving a block from a source stack to a target stack.
    ; Generalisation: Integrates clearing, unstacking, and restacking for fully lifted operation.
    :parameters (?above - block ?below - block ?under - block)
    :task (t-Make-On ?above ?below)
    :precondition (and 
      (on ?above ?under) 
      (not (= ?above ?below))
    )
    :ordered-subtasks (and
      (t-Make-Clear ?above)
      (t-Make-Clear ?below)
      (Unstack ?above ?under)
      (Stack ?above ?below)
    )
  )

  (:method m-Make-Clear-Done
    ; Evidence: Obstruction checks.
    ; Generalisation: Base case for recursive clearing.
    :parameters (?b - block)
    :task (t-Make-Clear ?b)
    :precondition (clear ?b)
    :subtasks ()
  )

  (:method m-Make-Clear-Unstack
    ; Evidence: Removing a top block to access the block beneath.
    ; Generalisation: Recursively makes the top block clear before unstacking it to the table.
    :parameters (?b - block ?top - block)
    :task (t-Make-Clear ?b)
    :precondition (on ?top ?b)
    :ordered-subtasks (and
      (t-Make-Clear ?top)
      (Unstack ?top ?b)
      (Putdown ?top)
    )
  )

  ; -----------------------------------------------------------------------
  ; ACTIONS
  ; -----------------------------------------------------------------------

  (:action Pickup
    :parameters (?b - block)
    :precondition (and
      (on-table ?b)
      (clear ?b)
      (hand-empty)
    )
    :effect (and
      (not (on-table ?b))
      (not (clear ?b))
      (not (hand-empty))
      (holding ?b)
    )
  )

  (:action Putdown
    :parameters (?b - block)
    :precondition (and
      (holding ?b)
    )
    :effect (and
      (not (holding ?b))
      (hand-empty)
      (on-table ?b)
      (clear ?b)
    )
  )

  (:action Unstack
    :parameters (?b1 - block ?b2 - block)
    :precondition (and
      (on ?b1 ?b2)
      (clear ?b1)
      (hand-empty)
    )
    :effect (and
      (not (on ?b1 ?b2))
      (not (clear ?b1))
      (not (hand-empty))
      (clear ?b2)
      (holding ?b1)
    )
  )

  (:action Stack
    :parameters (?b1 - block ?b2 - block)
    :precondition (and
      (holding ?b1)
      (clear ?b2)
    )
    :effect (and
      (not (holding ?b1))
      (not (clear ?b2))
      (hand-empty)
      (on ?b1 ?b2)
      (clear ?b1)
    )
  )
)
