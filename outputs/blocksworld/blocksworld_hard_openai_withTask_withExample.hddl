(define (domain Blocks4)
  (:requirements :hierarchy :strips :typing :equality)

  (:types block)

  (:predicates
    (on-table ?b - block)
    (on ?b1 - block ?b2 - block)
    (clear ?b - block)
    (hand-empty)
    (holding ?b - block)
  )

  (:task root-make-on-table
    :parameters
    (
      ?block - block
    )
  )

  (:task root-make-on
    :parameters
    (
      ?above - block
      ?below - block
    )
  )

  (:task t-clear-block
    :parameters
    (
      ?block - block
    )
  )

  (:task t-move-to-table
    :parameters
    (
      ?block - block
    )
  )

  (:task t-move-onto-block
    :parameters
    (
      ?above - block
      ?below - block
    )
  )

  (:method m-root-make-on-table-direct
    :parameters
    (
      ?block - block
    )
    :task (root-make-on-table ?block)
    :precondition
    (and
      (clear ?block)
    )
    :ordered-subtasks
    (and
      (t-move-to-table ?block)
    )
  )

  (:method m-root-make-on-table-via-clearing
    :parameters
    (
      ?block - block
    )
    :task (root-make-on-table ?block)
    :precondition
    (and
      (not (clear ?block))
    )
    :ordered-subtasks
    (and
      (t-clear-block ?block)
      (t-move-to-table ?block)
    )
  )

  (:method m-root-make-on-direct
    :parameters
    (
      ?above - block
      ?below - block
    )
    :task (root-make-on ?above ?below)
    :precondition
    (and
      (not (= ?above ?below))
      (clear ?above)
      (clear ?below)
    )
    :ordered-subtasks
    (and
      (t-move-onto-block ?above ?below)
    )
  )

  (:method m-root-make-on-clear-above
    :parameters
    (
      ?above - block
      ?below - block
    )
    :task (root-make-on ?above ?below)
    :precondition
    (and
      (not (= ?above ?below))
      (not (clear ?above))
      (clear ?below)
    )
    :ordered-subtasks
    (and
      (t-clear-block ?above)
      (t-move-onto-block ?above ?below)
    )
  )

  (:method m-root-make-on-clear-below
    :parameters
    (
      ?above - block
      ?below - block
    )
    :task (root-make-on ?above ?below)
    :precondition
    (and
      (not (= ?above ?below))
      (clear ?above)
      (not (clear ?below))
    )
    :ordered-subtasks
    (and
      (t-clear-block ?below)
      (t-move-onto-block ?above ?below)
    )
  )

  (:method m-root-make-on-clear-both
    :parameters
    (
      ?above - block
      ?below - block
    )
    :task (root-make-on ?above ?below)
    :precondition
    (and
      (not (= ?above ?below))
      (not (clear ?above))
      (not (clear ?below))
    )
    :ordered-subtasks
    (and
      (t-clear-block ?above)
      (t-clear-block ?below)
      (t-move-onto-block ?above ?below)
    )
  )

  (:method m-clear-block-done
    :parameters
    (
      ?block - block
    )
    :task (t-clear-block ?block)
    :precondition
    (and
      (clear ?block)
    )
    :subtasks ()
  )

  (:method m-clear-block-by-moving-top-to-table
    :parameters
    (
      ?block - block
      ?top - block
    )
    :task (t-clear-block ?block)
    :precondition
    (and
      (on ?top ?block)
      (clear ?top)
    )
    :ordered-subtasks
    (and
      (t-move-to-table ?top)
      (t-clear-block ?block)
    )
  )

  (:method m-move-to-table-from-table-done
    :parameters
    (
      ?block - block
    )
    :task (t-move-to-table ?block)
    :precondition
    (and
      (on-table ?block)
    )
    :subtasks ()
  )

  (:method m-move-to-table-from-stack
    :parameters
    (
      ?block - block
      ?below - block
    )
    :task (t-move-to-table ?block)
    :precondition
    (and
      (on ?block ?below)
      (clear ?block)
      (hand-empty)
    )
    :ordered-subtasks
    (and
      (Unstack ?block ?below)
      (Putdown ?block)
    )
  )

  (:method m-move-to-table-from-table-reposition
    :parameters
    (
      ?block - block
    )
    :task (t-move-to-table ?block)
    :precondition
    (and
      (holding ?block)
    )
    :ordered-subtasks
    (and
      (Putdown ?block)
    )
  )

  (:method m-move-onto-block-already
    :parameters
    (
      ?above - block
      ?below - block
    )
    :task (t-move-onto-block ?above ?below)
    :precondition
    (and
      (on ?above ?below)
    )
    :subtasks ()
  )

  (:method m-move-onto-block-from-table
    :parameters
    (
      ?above - block
      ?below - block
    )
    :task (t-move-onto-block ?above ?below)
    :precondition
    (and
      (not (= ?above ?below))
      (on-table ?above)
      (clear ?above)
      (clear ?below)
      (hand-empty)
    )
    :ordered-subtasks
    (and
      (Pickup ?above)
      (Stack ?above ?below)
    )
  )

  (:method m-move-onto-block-from-stack
    :parameters
    (
      ?above - block
      ?from - block
      ?below - block
    )
    :task (t-move-onto-block ?above ?below)
    :precondition
    (and
      (not (= ?above ?below))
      (not (= ?from ?below))
      (on ?above ?from)
      (clear ?above)
      (clear ?below)
      (hand-empty)
    )
    :ordered-subtasks
    (and
      (Unstack ?above ?from)
      (Stack ?above ?below)
    )
  )

  (:action Pickup
    :parameters
    (
      ?b - block
    )
    :precondition
    (and
      (on-table ?b)
      (clear ?b)
      (hand-empty)
    )
    :effect
    (and
      (not (on-table ?b))
      (not (clear ?b))
      (not (hand-empty))
      (holding ?b)
    )
  )

  (:action Putdown
    :parameters
    (
      ?b - block
    )
    :precondition
    (and
      (holding ?b)
    )
    :effect
    (and
      (not (holding ?b))
      (hand-empty)
      (on-table ?b)
      (clear ?b)
    )
  )

  (:action Unstack
    :parameters
    (
      ?b1 - block
      ?b2 - block
    )
    :precondition
    (and
      (on ?b1 ?b2)
      (clear ?b1)
      (hand-empty)
    )
    :effect
    (and
      (not (on ?b1 ?b2))
      (not (clear ?b1))
      (not (hand-empty))
      (clear ?b2)
      (holding ?b1)
    )
  )

  (:action Stack
    :parameters
    (
      ?b1 - block
      ?b2 - block
    )
    :precondition
    (and
      (holding ?b1)
      (clear ?b2)
    )
    :effect
    (and
      (not (holding ?b1))
      (not (clear ?b2))
      (hand-empty)
      (on ?b1 ?b2)
      (clear ?b1)
    )
  )
)