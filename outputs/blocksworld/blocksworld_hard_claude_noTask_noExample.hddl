(define (domain Blocks4)

  (:requirements :hierarchy :strips :typing :equality)

  (:types block)

  (:predicates
    (on-table ?b - block)
    (on ?b1 - block ?b2 - block)
    (clear ?b - block)
    (hand-empty)
    (holding ?b - block)
  )

  ; ROOT TASK: build a tower on a target block, placing one block on top of another
  ; Observed in both 2_6 and 2_7: blocks are moved from various stacks onto a single destination stack
  (:task root_build_tower
    :parameters (?top - block ?bottom - block)
  )

  ; Task: move a block to be on top of another block (general move-to-stack)
  ; Observed: each individual move in 2_6 and 2_7 corresponds to placing one block onto another
  (:task move_block_onto
    :parameters (?b - block ?target - block)
  )

  ; Task: clear a block so it can receive another block or be picked up
  ; Observed: before placing onto a block, the target must be clear; blocks above are removed first
  (:task clear_block
    :parameters (?b - block)
  )

  ; Task: move a block to the table (used as intermediate step)
  ; Observed: blocks are sometimes put on table as intermediate positions during rearrangement
  (:task move_to_table
    :parameters (?b - block)
  )

  ; Method: build tower base case - place top block directly onto bottom when both are ready
  ; top block is in hand or on table clear, bottom block is already clear
  ; Strongly supported: final stack step observed in both demonstrations
  (:method m_build_tower_base
    :parameters (?top - block ?bottom - block)
    :task (root_build_tower ?top ?bottom)
    :precondition (and
      (clear ?bottom)
    )
    :ordered-subtasks (and
      (move_block_onto ?top ?bottom)
    )
  )

  ; Method: build tower recursive - clear the target, then place the block
  ; Observed: multiple blocks removed from destination stack before building begins
  ; Generalises: whenever destination is not clear, recursively clear it first
  (:method m_build_tower_clear_first
    :parameters (?top - block ?bottom - block ?obstacle - block)
    :task (root_build_tower ?top ?bottom)
    :precondition (and
      (on ?obstacle ?bottom)
      (clear ?obstacle)
    )
    :ordered-subtasks (and
      (clear_block ?bottom)
      (move_block_onto ?top ?bottom)
    )
  )

  ; Method: move block onto target when block is on table and target is clear
  ; Strongly supported: seen in both demos - pickup from table then stack
  (:method m_move_onto_from_table
    :parameters (?b - block ?target - block)
    :task (move_block_onto ?b ?target)
    :precondition (and
      (on-table ?b)
      (clear ?b)
      (clear ?target)
      (hand-empty)
    )
    :ordered-subtasks (and
      (Pickup ?b)
      (Stack ?b ?target)
    )
  )

  ; Method: move block onto target when block is on another block and target is clear
  ; Strongly supported: seen in both demos - unstack then stack
  (:method m_move_onto_from_stack
    :parameters (?b - block ?from - block ?target - block)
    :task (move_block_onto ?b ?target)
    :precondition (and
      (on ?b ?from)
      (clear ?b)
      (clear ?target)
      (hand-empty)
    )
    :ordered-subtasks (and
      (Unstack ?b ?from)
      (Stack ?b ?target)
    )
  )

  ; Method: move block onto target when block is on another block and target needs clearing
  ; Observed: target stack had blocks that needed removal before placement
  ; Generalises: clear target first, then move block from its current stack
  (:method m_move_onto_clear_target_first_from_stack
    :parameters (?b - block ?from - block ?target - block)
    :task (move_block_onto ?b ?target)
    :precondition (and
      (on ?b ?from)
      (clear ?b)
      (not (clear ?target))
      (hand-empty)
    )
    :ordered-subtasks (and
      (clear_block ?target)
      (Unstack ?b ?from)
      (Stack ?b ?target)
    )
  )

  ; Method: move block onto target when block is on table and target needs clearing
  ; Tentative generalisation: symmetric case of above for table-based source block
  (:method m_move_onto_clear_target_first_from_table
    :parameters (?b - block ?target - block)
    :task (move_block_onto ?b ?target)
    :precondition (and
      (on-table ?b)
      (clear ?b)
      (not (clear ?target))
      (hand-empty)
    )
    :ordered-subtasks (and
      (clear_block ?target)
      (Pickup ?b)
      (Stack ?b ?target)
    )
  )

  ; Method: clear a block that already is clear - base case, nothing to do
  ; Observed: when a block is already clear, no clearing action needed
  ; Implemented as a no-op using a dummy identity via move_to_table of nothing - 
  ; Instead: clear_block base case simply checks the block is already clear
  ; HDDL requires at least one subtask in ordered-subtasks; use empty decomposition via sentinel
  ; Tentative: represented as direct no-op via table move of obstacle
  (:method m_clear_block_already_clear
    :parameters (?b - block)
    :task (clear_block ?b)
    :precondition (and
      (clear ?b)
    )
    :ordered-subtasks (and
    )
  )

  ; Method: clear a block by moving the top block (which is on table) off
  ; Observed: the block on top must be removed to expose the destination block
  ; Strongly supported: repeatedly seen in 2_6 (D, C removed from stack 1) and 2_7
  (:method m_clear_block_move_top_to_table
    :parameters (?b - block ?top - block)
    :task (clear_block ?b)
    :precondition (and
      (on ?top ?b)
      (clear ?top)
      (hand-empty)
    )
    :ordered-subtasks (and
      (move_to_table ?top)
    )
  )

  ; Method: clear a block by recursively clearing the top block then removing it
  ; Observed: chains of blocks must be removed one at a time from top to bottom
  ; Generalises to stacks of arbitrary height
  (:method m_clear_block_recursive
    :parameters (?b - block ?top - block ?above_top - block)
    :task (clear_block ?b)
    :precondition (and
      (on ?top ?b)
      (on ?above_top ?top)
      (hand-empty)
    )
    :ordered-subtasks (and
      (clear_block ?top)
      (move_to_table ?top)
    )
  )

  ; Method: move a block to table when it is already on the table - base no-op case
  ; Tentative: degenerate case where block is already on table
  (:method m_move_to_table_already_there
    :parameters (?b - block)
    :task (move_to_table ?b)
    :precondition (and
      (on-table ?b)
      (clear ?b)
    )
    :ordered-subtasks (and
    )
  )

  ; Method: move a block to table by unstacking it from its current base
  ; Strongly supported: in 2_6 block D unstacked from C and placed on table/other stack
  (:method m_move_to_table_from_stack
    :parameters (?b - block ?from - block)
    :task (move_to_table ?b)
    :precondition (and
      (on ?b ?from)
      (clear ?b)
      (hand-empty)
    )
    :ordered-subtasks (and
      (Unstack ?b ?from)
      (Putdown ?b)
    )
  )

  ; Method: move a block to table by picking it up from the table (re-put - no-op path)
  ; Tentative: block is on table but not clear; this case should not arise if clear_block used correctly
  ; Kept for completeness; will only fire when block is already on table and clear
  (:method m_move_to_table_pickup
    :parameters (?b - block)
    :task (move_to_table ?b)
    :precondition (and
      (on-table ?b)
      (clear ?b)
      (hand-empty)
    )
    :ordered-subtasks (and
      (Pickup ?b)
      (Putdown ?b)
    )
  )

  (:action Pickup
    :parameters (
      ?b - block
    )
    :precondition
    ( and
      ( on-table ?b )
      ( clear ?b )
      ( hand-empty )
    )
    :effect
    ( and
      ( not ( on-table ?b ) )
      ( not ( clear ?b ) )
      ( not ( hand-empty ) )
      ( holding ?b )
    )
  )

  (:action Putdown
    :parameters (
      ?b - block
    )
    :precondition
    ( and
      ( holding ?b )
    )
    :effect
    ( and
      ( not ( holding ?b ) )
      ( hand-empty )
      ( on-table ?b )
      ( clear ?b )
    )
  )

  (:action Unstack
    :parameters (
      ?b1 - block
      ?b2 - block
    )
    :precondition
    ( and
      ( on ?b1 ?b2 )
      ( clear ?b1 )
      ( hand-empty )
    )
    :effect
    ( and
      ( not ( on ?b1 ?b2 ) )
      ( not ( clear ?b1 ) )
      ( not ( hand-empty ) )
      ( clear ?b2 )
      ( holding ?b1 )
    )
  )

  (:action Stack
    :parameters (
      ?b1 - block
      ?b2 - block
    )
    :precondition
    ( and
      ( holding ?b1 )
      ( clear ?b2 )
    )
    :effect
    ( and
      ( not ( holding ?b1 ) )
      ( not ( clear ?b2 ) )
      ( hand-empty )
      ( on ?b1 ?b2 )
      ( clear ?b1 )
    )
  )

)
