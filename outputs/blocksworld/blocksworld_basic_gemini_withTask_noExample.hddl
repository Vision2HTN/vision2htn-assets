(define (domain Blocks4)
  (:requirements :strips :typing :equality :hierarchy)

  (:types
    block
  )

  (:predicates
    (on-table ?b - block)
    (on ?b1 - block ?b2 - block)
    (clear ?b - block)
    (hand-empty)
    (holding ?b - block)
  )

  (:task t-Make-On-Table
    :parameters (?block - block)
  )

  (:task t-Make-On
    :parameters (?above - block ?below - block)
  )

  (:task t-clear
    :parameters (?b - block)
  )

  (:task t-get
    :parameters (?b - block)
  )

  (:method m-make-on-table-already
    :parameters (?block - block)
    :task (t-Make-On-Table ?block)
    :precondition (and (on-table ?block))
    :ordered-subtasks ()
  )

  (:method m-make-on-table-action
    :parameters (?block - block)
    :task (t-Make-On-Table ?block)
    :precondition (and (not (on-table ?block)))
    :ordered-subtasks (and
      (t-clear ?block)
      (t-get ?block)
      (Putdown ?block)
    )
  )

  (:method m-make-on-already
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (and (on ?above ?below))
    :ordered-subtasks ()
  )

  (:method m-make-on-action
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (and
      (not (on ?above ?below))
      (not (= ?above ?below))
    )
    :ordered-subtasks (and
      (t-clear ?above)
      (t-clear ?below)
      (t-get ?above)
      (Stack ?above ?below)
    )
  )

  (:method m-clear-already
    :parameters (?b - block)
    :task (t-clear ?b)
    :precondition (and (clear ?b))
    :ordered-subtasks ()
  )

  (:method m-clear-block
    :parameters (?b - block ?top - block)
    :task (t-clear ?b)
    :precondition (and (on ?top ?b))
    :ordered-subtasks (and
      (t-clear ?top)
      (Unstack ?top ?b)
      (Putdown ?top)
    )
  )

  (:method m-get-from-table
    :parameters (?b - block)
    :task (t-get ?b)
    :precondition (and (on-table ?b) (clear ?b) (hand-empty))
    :ordered-subtasks (and
      (Pickup ?b)
    )
  )

  (:method m-get-from-block
    :parameters (?b - block ?other - block)
    :task (t-get ?b)
    :precondition (and (on ?b ?other) (clear ?b) (hand-empty))
    :ordered-subtasks (and
      (Unstack ?b ?other)
    )
  )

  (:action Pickup
    :parameters (?b - block)
    :precondition (and
      (on-table ?b)
      (clear ?b)
      (hand-empty)
    )
    :effect (and
      (not (on-table ?b))
      (not (clear ?b))
      (not (hand-empty))
      (holding ?b)
    )
  )

  (:action Putdown
    :parameters (?b - block)
    :precondition (and
      (holding ?b)
    )
    :effect (and
      (not (holding ?b))
      (hand-empty)
      (on-table ?b)
      (clear ?b)
    )
  )

  (:action Unstack
    :parameters (?b1 - block ?b2 - block)
    :precondition (and
      (on ?b1 ?b2)
      (clear ?b1)
      (hand-empty)
    )
    :effect (and
      (not (on ?b1 ?b2))
      (not (clear ?b1))
      (not (hand-empty))
      (clear ?b2)
      (holding ?b1)
    )
  )

  (:action Stack
    :parameters (?b1 - block ?b2 - block)
    :precondition (and
      (holding ?b1)
      (clear ?b2)
    )
    :effect (and
      (not (holding ?b1))
      (not (clear ?b2))
      (hand-empty)
      (on ?b1 ?b2)
      (clear ?b1)
    )
  )

)