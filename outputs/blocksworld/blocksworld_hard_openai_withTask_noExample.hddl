(define (domain Blocks4)
  (:requirements :hierarchy :strips :typing :equality)

  (:types block)

  (:predicates
    (on-table ?b - block)
    (on ?b1 - block ?b2 - block)
    (clear ?b - block)
    (hand-empty)
    (holding ?b - block)
  )

  (:task root-make-on-table ; ROOT TASK ; strongly supported: demos repeatedly move a clear top block from a stack onto an empty table position; general goal-level task for placing any block on the table
    :parameters (?block - block)
  )

  (:task root-make-on ; ROOT TASK ; strongly supported: demos repeatedly achieve new on-relations such as H on D, G on C, F on H, D on E, C on D, B on C, A on B; general lifted stacking objective
    :parameters (?above - block ?below - block)
  )

  (:task t-Make-On-Table ; provided task context; general subgoal for achieving table placement
    :parameters (?block - block)
  )

  (:task t-Make-On ; provided task context; general subgoal for achieving a support relation
    :parameters (?above - block ?below - block)
  )

  (:method m-root-make-on-table-direct
    :parameters (?block - block)
    :task (root-make-on-table ?block)
    :precondition (and)
    :ordered-subtasks (and
      (t-Make-On-Table ?block)
    )
  )

  (:method m-root-make-on-direct
    :parameters (?above - block ?below - block)
    :task (root-make-on ?above ?below)
    :precondition (and)
    :ordered-subtasks (and
      (t-Make-On ?above ?below)
    )
  )

  (:method m-make-on-table-already
    :parameters (?block - block)
    :task (t-Make-On-Table ?block)
    :precondition (and
      (on-table ?block)
    )
    :ordered-subtasks (and)
  )

  (:method m-make-on-table-from-holding
    :parameters (?block - block)
    :task (t-Make-On-Table ?block)
    :precondition (and
      (holding ?block)
    )
    :ordered-subtasks (and
      (Putdown ?block)
    )
  )

  (:method m-make-on-table-from-table-pickup-putdown
    :parameters (?block - block)
    :task (t-Make-On-Table ?block)
    :precondition (and
      (on-table ?block)
      (clear ?block)
      (hand-empty)
    )
    :ordered-subtasks (and
      (Pickup ?block)
      (Putdown ?block)
    )
  )

  (:method m-make-on-table-from-stack
    :parameters (?block - block ?support - block)
    :task (t-Make-On-Table ?block)
    :precondition (and
      (on ?block ?support)
      (clear ?block)
      (hand-empty)
      (not (= ?block ?support))
    )
    :ordered-subtasks (and
      (Unstack ?block ?support)
      (Putdown ?block)
    )
  )

  (:method m-make-on-already
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (and
      (on ?above ?below)
      (not (= ?above ?below))
    )
    :ordered-subtasks (and)
  )

  (:method m-make-on-from-holding
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (and
      (holding ?above)
      (clear ?below)
      (not (= ?above ?below))
    )
    :ordered-subtasks (and
      (Stack ?above ?below)
    )
  )

  (:method m-make-on-from-table
    :parameters (?above - block ?below - block)
    :task (t-Make-On ?above ?below)
    :precondition (and
      (on-table ?above)
      (clear ?above)
      (clear ?below)
      (hand-empty)
      (not (= ?above ?below))
    )
    :ordered-subtasks (and
      (Pickup ?above)
      (Stack ?above ?below)
    )
  )

  (:method m-make-on-from-stack
    :parameters (?above - block ?below - block ?oldsupport - block)
    :task (t-Make-On ?above ?below)
    :precondition (and
      (on ?above ?oldsupport)
      (clear ?above)
      (clear ?below)
      (hand-empty)
      (not (= ?above ?below))
      (not (= ?above ?oldsupport))
      (not (= ?below ?oldsupport))
    )
    :ordered-subtasks (and
      (Unstack ?above ?oldsupport)
      (Stack ?above ?below)
    )
  )

  (:action Pickup
    :parameters
    (
      ?b - block
    )
    :precondition
    ( and
      ( on-table ?b )
      ( clear ?b )
      ( hand-empty )
    )
    :effect
    ( and
      ( not ( on-table ?b ) )
      ( not ( clear ?b ) )
      ( not ( hand-empty ) )
      ( holding ?b )
    )
  )

  (:action Putdown
    :parameters
    (
      ?b - block
    )
    :precondition
    ( and
      ( holding ?b )
    )
    :effect
    ( and
      ( not ( holding ?b ) )
      ( hand-empty )
      ( on-table ?b )
      ( clear ?b )
    )
  )

  (:action Unstack
    :parameters
    (
      ?b1 - block
      ?b2 - block
    )
    :precondition
    ( and
      ( on ?b1 ?b2 )
      ( clear ?b1 )
      ( hand-empty )
    )
    :effect
    ( and
      ( not ( on ?b1 ?b2 ) )
      ( not ( clear ?b1 ) )
      ( not ( hand-empty ) )
      ( clear ?b2 )
      ( holding ?b1 )
    )
  )

  (:action Stack
    :parameters
    (
      ?b1 - block
      ?b2 - block
    )
    :precondition
    ( and
      ( holding ?b1 )
      ( clear ?b2 )
    )
    :effect
    ( and
      ( not ( holding ?b1 ) )
      ( not ( clear ?b2 ) )
      ( hand-empty )
      ( on ?b1 ?b2 )
      ( clear ?b1 )
    )
  )
)
