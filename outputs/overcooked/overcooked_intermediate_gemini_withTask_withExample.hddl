(define (domain overcooked)
  (:requirements :negative-preconditions :hierarchy :typing :equality)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task t-serve-dish
    :parameters (?dish - dish)
  )

  (:task t-fulfill_ingredient
    :parameters (?pot - pot ?i - ingredient ?count - count)
  )

  (:task t-add-one-ingredient
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count)
  )

  (:task t-cook
    :parameters (?pot - pot ?dish - dish ?finish - status)
  )

  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  (:task t-deliver-dish
    :parameters (?a - agent ?dish - dish)
  )

  (:method m-get-to-already-there
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks ()
  )

  (:method m-get-to-move
    :parameters (?a - agent ?l1 ?l2 ?l-dest - location)
    :task (t-get-to ?a ?l-dest)
    :precondition (and
      (at ?a ?l1)
      (connect ?l1 ?l2)
    )
    :ordered-subtasks (and
      (move ?a ?l1 ?l2)
      (t-get-to ?a ?l-dest)
    )
  )

  (:method m-get-item-direct
    :parameters (?a - agent ?item - item ?pile - pile ?l - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (at ?pile ?l)
      (contains ?pile ?item)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-pile ?a ?pile ?l ?item ?free)
    )
  )

  (:method m-get-item-collab
    :parameters (?a1 ?a2 - agent ?item - item ?table - table ?l1 ?l2 - location ?free - marker)
    :task (t-get-item ?a2 ?item)
    :precondition (and
      (reachable ?table ?l1)
      (reachable ?table ?l2)
      (not (= ?a1 ?a2))
      (holding ?a2 ?free)
      (holding ?table ?free)
    )
    :ordered-subtasks (and
      (t-get-item ?a1 ?item)
      (t-get-to ?a1 ?l1)
      (drop-off-to-table ?a1 ?table ?l1 ?item ?free)
      (t-get-to ?a2 ?l2)
      (pick-up-from-table ?a2 ?table ?l2 ?item ?free)
    )
  )

  (:method m-add-ingredient
    :parameters (?a - agent ?pot - pot ?pot-loc - location ?i - ingredient ?current ?next - count ?free - marker ?idle - status)
    :task (t-add-one-ingredient ?pot ?i ?current ?next)
    :precondition (and
      (at ?pot ?pot-loc)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?i)
      (t-get-to ?a ?pot-loc)
      (add-to-pot ?a ?pot ?pot-loc ?i ?current ?next ?free ?idle)
    )
  )

  (:method m-fulfill-done
    :parameters (?pot - pot ?i - ingredient ?count - count)
    :task (t-fulfill_ingredient ?pot ?i ?count)
    :precondition (in-pot ?pot ?i ?count)
    :ordered-subtasks ()
  )

  (:method m-fulfill-step
    :parameters (?pot - pot ?i - ingredient ?target-count ?current-count ?next-count - count)
    :task (t-fulfill_ingredient ?pot ?i ?target-count)
    :precondition (and
      (in-pot ?pot ?i ?current-count)
      (increment ?current-count ?next-count)
      (not (= ?current-count ?target-count))
    )
    :ordered-subtasks (and
      (t-add-one-ingredient ?pot ?i ?current-count ?next-count)
      (t-fulfill_ingredient ?pot ?i ?target-count)
    )
  )

  (:method m-cook-done
    :parameters (?pot - pot ?dish - dish ?finish - status)
    :task (t-cook ?pot ?dish ?finish)
    :precondition (pot-status ?pot ?finish)
    :ordered-subtasks ()
  )

  (:method m-cook-step
    :parameters (?pot - pot ?dish - dish ?s1 ?s2 ?finish - status)
    :task (t-cook ?pot ?dish ?finish)
    :precondition (and
      (pot-status ?pot ?s1)
      (cooking-progress ?s1 ?s2)
      (not (= ?s1 ?finish))
    )
    :ordered-subtasks (and
      (cook ?pot ?s1 ?s2)
      (t-cook ?pot ?dish ?finish)
    )
  )

  (:method m-deliver-dish-direct
    :parameters (?a - agent ?dish - dish ?del - delivery ?del-loc - location ?free - marker)
    :task (t-deliver-dish ?a ?dish)
    :precondition (and
      (at ?del ?del-loc)
      (holding ?a ?dish)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?del-loc)
      (drop-off-to-delivery ?a ?del ?del-loc ?dish ?free)
    )
  )

  (:method m-deliver-dish-collab
    :parameters (?a1 ?a2 - agent ?dish - dish ?del - delivery ?del-loc - location ?table - table ?l1 ?l2 - location ?free - marker)
    :task (t-deliver-dish ?a1 ?dish)
    :precondition (and
      (reachable ?table ?l1)
      (reachable ?table ?l2)
      (not (= ?a1 ?a2))
      (at ?del ?del-loc)
      (holding ?a1 ?dish)
      (holding ?table ?free)
      (holding ?a2 ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a1 ?l1)
      (drop-off-to-table ?a1 ?table ?l1 ?dish ?free)
      (t-get-to ?a2 ?l2)
      (pick-up-from-table ?a2 ?table ?l2 ?dish ?free)
      (t-deliver-dish ?a2 ?dish)
    )
  )

  (:method m-serve-dish
    :parameters (?dish - dish ?pot - pot ?pot-loc - location ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start ?finish - status ?a1 ?a2 - agent ?bowl - bowl)
    :task (t-serve-dish ?dish)
    :precondition (and
      (recipe ?dish ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (finished-status ?finish)
      (at ?pot ?pot-loc)
    )
    :ordered-subtasks (and
      (t-fulfill_ingredient ?pot ?i1 ?n1)
      (t-fulfill_ingredient ?pot ?i2 ?n2)
      (t-get-to ?a1 ?pot-loc)
      (start-cook ?a1 ?pot ?pot-loc ?dish ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (t-cook ?pot ?dish ?finish)
      (t-get-item ?a2 ?bowl)
      (t-get-to ?a2 ?pot-loc)
      (pour-from-pot ?a2 ?pot ?pot-loc ?dish ?bowl ?finish ?idle)
      (t-deliver-dish ?a2 ?dish)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)