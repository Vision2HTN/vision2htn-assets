(define (domain overcooked)

  (:requirements :hierarchy :strips :typing)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  ; ROOT TASK: top-level goal to serve a dish
  (:task t-serve-dish
    :parameters (?dish - dish)
  )

  ; Subtask: ensure a pot has required amount of one ingredient
  (:task t-fulfill_ingredient
    :parameters (?pot - pot ?i - ingredient ?count - count)
  )

  ; Subtask: add one unit of an ingredient to a pot
  (:task t-add-one-ingredient
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count)
  )

  ; Subtask: navigate agent to a location
  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  ; Subtask: get an item into agent hand
  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  ; Subtask: cook until finished
  (:task t-cook-until-done
    :parameters (?pot - pot)
  )

  ; Subtask: pour cooked dish into bowl
  (:task t-pour-dish
    :parameters (?a - agent ?pot - pot ?b - bowl ?dish - dish ?l - location)
  )

  ; Subtask: deliver dish to delivery point
  (:task t-deliver
    :parameters (?a - agent ?dish - dish ?del - delivery ?l - location)
  )

  ; Subtask: pass item between agents via table
  (:task t-pass-item
    :parameters (?giver - agent ?receiver - agent ?item - item ?table - table)
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-serve-dish
  ; -----------------------------------------------------------------------

  ; Single-agent method: one agent does everything
  ; Observed: agent picks onions, adds to pot, cooks, pours, delivers
  (:method m-serve-dish-single-agent
    :parameters (
      ?dish - dish
      ?a - agent
      ?pot - pot
      ?i1 ?i2 - ingredient
      ?n1 ?n2 ?zero - count
      ?b - bowl
      ?del - delivery
      ?lpot ?ldel ?la - location
      ?idle ?finish - status
      ?free - marker
    )
    :task (t-serve-dish ?dish)
    :precondition (and
      (recipe ?dish ?i1 ?n1 ?i2 ?n2)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (finished-status ?finish)
      (is-zero ?zero)
      (at ?pot ?lpot)
      (at ?del ?ldel)
    )
    :ordered-subtasks (and
      (t-fulfill_ingredient ?pot ?i1 ?n1)
      (t-fulfill_ingredient ?pot ?i2 ?n2)
      (t-get-to ?a ?lpot)
      (start-cook ?a ?pot ?lpot ?dish ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?finish)
      (t-cook-until-done ?pot)
      (t-pour-dish ?a ?pot ?b ?dish ?lpot)
      (t-deliver ?a ?dish ?del ?ldel)
    )
  )

  ; Two-agent collaborative method: one agent handles ingredients/pot side,
  ; other handles delivery side; pass intermediate items via table
  ; Observed: agent0 (blue) picks and adds ingredients, agent1 (green) pours and delivers
  ; Tentative: generalises to any two-agent split
  (:method m-serve-dish-two-agent-collab
    :parameters (
      ?dish - dish
      ?a1 ?a2 - agent
      ?pot - pot
      ?i1 ?i2 - ingredient
      ?n1 ?n2 ?zero - count
      ?b - bowl
      ?del - delivery
      ?lpot ?ldel - location
      ?idle ?finish - status
      ?free1 ?free2 - marker
      ?pass-table - table
    )
    :task (t-serve-dish ?dish)
    :precondition (and
      (recipe ?dish ?i1 ?n1 ?i2 ?n2)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (finished-status ?finish)
      (is-zero ?zero)
      (at ?pot ?lpot)
      (at ?del ?ldel)
    )
    :ordered-subtasks (and
      (t-fulfill_ingredient ?pot ?i1 ?n1)
      (t-fulfill_ingredient ?pot ?i2 ?n2)
      (t-get-to ?a1 ?lpot)
      (start-cook ?a1 ?pot ?lpot ?dish ?i1 ?i2 ?n1 ?n2 ?zero ?free1 ?idle ?finish)
      (t-cook-until-done ?pot)
      (t-pour-dish ?a2 ?pot ?b ?dish ?lpot)
      (t-deliver ?a2 ?dish ?del ?ldel)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-fulfill_ingredient
  ; -----------------------------------------------------------------------

  ; Base case: ingredient already at required count
  ; Observed: when pot already has zero, incrementally add
  (:method m-fulfill-ingredient-done
    :parameters (?pot - pot ?i - ingredient ?count - count)
    :task (t-fulfill_ingredient ?pot ?i ?count)
    :precondition (in-pot ?pot ?i ?count)
    :ordered-subtasks ()
  )

  ; Recursive case: add one more and recurse
  ; Observed: agent picks one onion, adds to pot, repeats
  (:method m-fulfill-ingredient-recurse
    :parameters (
      ?pot - pot
      ?i - ingredient
      ?count - count
      ?ncurrent ?nnext - count
      ?a - agent
      ?lpot - location
      ?free - marker
      ?idle - status
    )
    :task (t-fulfill_ingredient ?pot ?i ?count)
    :precondition (and
      (in-pot ?pot ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
      (not (in-pot ?pot ?i ?count))
      (at ?pot ?lpot)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
      (t-fulfill_ingredient ?pot ?i ?count)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-add-one-ingredient
  ; Observed: agent moves to pile, picks onion, moves to pot, adds it
  ; -----------------------------------------------------------------------

  ; Agent picks from pile and adds directly
  (:method m-add-one-ingredient-from-pile
    :parameters (
      ?pot - pot
      ?i - ingredient
      ?ncurrent ?nnext - count
      ?a - agent
      ?pile - pile
      ?lpile ?lpot - location
      ?free - marker
      ?idle - status
    )
    :task (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
    :precondition (and
      (contains ?pile ?i)
      (at ?pile ?lpile)
      (at ?pot ?lpot)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (in-pot ?pot ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpile)
      (pick-up-from-pile ?a ?pile ?lpile ?i ?free)
      (t-get-to ?a ?lpot)
      (add-to-pot ?a ?pot ?lpot ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  ; Agent picks item passed on table and adds to pot
  ; Tentative: collaborative scenario where one agent passes ingredient to other
  (:method m-add-one-ingredient-from-table
    :parameters (
      ?pot - pot
      ?i - ingredient
      ?ncurrent ?nnext - count
      ?a - agent
      ?table - table
      ?lpot ?ltable - location
      ?free - marker
      ?idle - status
    )
    :task (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
    :precondition (and
      (holding ?table ?i)
      (reachable ?table ?ltable)
      (at ?pot ?lpot)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (in-pot ?pot ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?ltable)
      (pick-up-from-table ?a ?table ?ltable ?i ?free)
      (t-get-to ?a ?lpot)
      (add-to-pot ?a ?pot ?lpot ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-get-to
  ; -----------------------------------------------------------------------

  ; Already at destination
  (:method m-get-to-done
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks ()
  )

  ; Move one step and recurse
  ; Observed: agents traverse multiple cells to reach pile or pot
  (:method m-get-to-move
    :parameters (?a - agent ?l - location ?from ?mid - location)
    :task (t-get-to ?a ?l)
    :precondition (and
      (at ?a ?from)
      (connect ?from ?mid)
      (not (at ?a ?l))
    )
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-get-to ?a ?l)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-get-item
  ; -----------------------------------------------------------------------

  ; Already holding the item
  (:method m-get-item-done
    :parameters (?a - agent ?item - item)
    :task (t-get-item ?a ?item)
    :precondition (holding ?a ?item)
    :ordered-subtasks ()
  )

  ; Pick from pile
  ; Observed: agent picks onion from onion pile
  (:method m-get-item-from-pile
    :parameters (
      ?a - agent
      ?item - item
      ?pile - pile
      ?l - location
      ?free - marker
    )
    :task (t-get-item ?a ?item)
    :precondition (and
      (contains ?pile ?item)
      (at ?pile ?l)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-pile ?a ?pile ?l ?item ?free)
    )
  )

  ; Pick from table
  ; Tentative: item placed on table by another agent
  (:method m-get-item-from-table
    :parameters (
      ?a - agent
      ?item - item
      ?table - table
      ?l - location
      ?free - marker
    )
    :task (t-get-item ?a ?item)
    :precondition (and
      (holding ?table ?item)
      (reachable ?table ?l)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-table ?a ?table ?l ?item ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-cook-until-done
  ; -----------------------------------------------------------------------

  ; Already finished
  (:method m-cook-done
    :parameters (?pot - pot ?finish - status)
    :task (t-cook-until-done ?pot)
    :precondition (and
      (pot-status ?pot ?finish)
      (finished-status ?finish)
    )
    :ordered-subtasks ()
  )

  ; One cook step then recurse
  ; Observed: pot cooking counter ticks down each timestep
  (:method m-cook-step
    :parameters (?pot - pot ?s1 ?s2 - status)
    :task (t-cook-until-done ?pot)
    :precondition (and
      (pot-status ?pot ?s1)
      (cooking-progress ?s1 ?s2)
      (not (finished-status ?s1))
    )
    :ordered-subtasks (and
      (cook ?pot ?s1 ?s2)
      (t-cook-until-done ?pot)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-pour-dish
  ; -----------------------------------------------------------------------

  ; Agent navigates to pot, picks bowl, pours
  ; Observed: agent picks bowl, moves to pot, pours cooked soup
  (:method m-pour-dish-with-bowl
    :parameters (
      ?a - agent
      ?pot - pot
      ?b - bowl
      ?dish - dish
      ?lpot ?lbowl - location
      ?finish ?idle - status
      ?table - table
    )
    :task (t-pour-dish ?a ?pot ?b ?dish ?lpot)
    :precondition (and
      (at ?pot ?lpot)
      (pot-status ?pot ?finish)
      (finished-status ?finish)
      (idle-status ?idle)
      (label-pot-dish ?pot ?dish)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?b)
      (t-get-to ?a ?lpot)
      (pour-from-pot ?a ?pot ?lpot ?dish ?b ?finish ?idle)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-deliver
  ; -----------------------------------------------------------------------

  ; Agent moves to delivery and drops off
  ; Observed: agent moves to delivery counter and drops dish
  (:method m-deliver-direct
    :parameters (
      ?a - agent
      ?dish - dish
      ?del - delivery
      ?ldel - location
      ?free - marker
    )
    :task (t-deliver ?a ?dish ?del ?ldel)
    :precondition (and
      (at ?del ?ldel)
      (holding ?a ?dish)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?ldel)
      (drop-off-to-delivery ?a ?del ?ldel ?dish ?free)
    )
  )

  ; Agent picks up dish from table then delivers
  ; Tentative: another agent left the dish on a table
  (:method m-deliver-via-table
    :parameters (
      ?a - agent
      ?dish - dish
      ?del - delivery
      ?ldel ?ltable - location
      ?free - marker
      ?table - table
    )
    :task (t-deliver ?a ?dish ?del ?ldel)
    :precondition (and
      (at ?del ?ldel)
      (holding ?table ?dish)
      (reachable ?table ?ltable)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?ltable)
      (pick-up-from-table ?a ?table ?ltable ?dish ?free)
      (t-get-to ?a ?ldel)
      (drop-off-to-delivery ?a ?del ?ldel ?dish ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS FOR t-pass-item
  ; Observed: agents pass items via shared table to cross barrier
  ; -----------------------------------------------------------------------

  ; Giver drops on table, receiver picks up
  (:method m-pass-item-via-table
    :parameters (
      ?giver ?receiver - agent
      ?item - item
      ?table - table
      ?lgiver ?lreceiver - location
      ?free-giver ?free-receiver - marker
    )
    :task (t-pass-item ?giver ?receiver ?item ?table)
    :precondition (and
      (holding ?giver ?item)
      (reachable ?table ?lgiver)
      (reachable ?table ?lreceiver)
      (holding ?table ?free-giver)
    )
    :ordered-subtasks (and
      (t-get-to ?giver ?lgiver)
      (drop-off-to-table ?giver ?table ?lgiver ?item ?free-giver)
      (t-get-to ?receiver ?lreceiver)
      (pick-up-from-table ?receiver ?table ?lreceiver ?item ?free-receiver)
    )
  )

  ; -----------------------------------------------------------------------
  ; ACTIONS (copied verbatim from PDDL domain)
  ; -----------------------------------------------------------------------

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )

)
