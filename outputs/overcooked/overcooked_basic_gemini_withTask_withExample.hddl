(define (domain overcooked)
  (:requirements :strips :typing :hierarchy :negative-preconditions :equality)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task t-serve-dish
    :parameters (?dish - dish)
  )

  (:task t-fulfill_ingredient
    :parameters (?pot - pot ?i - ingredient ?count - count)
  )

  (:task t-add-one-ingredient
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count)
  )

  (:task t-cook
    :parameters (?pot - pot ?dish - dish ?finish - status)
  )

  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  (:task t-deliver-dish
    :parameters (?a - agent ?d - dish)
  )

  (:method m-serve-dish
    :parameters (?d - dish ?p - pot ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?idle ?start ?finish - status ?a - agent ?l-pot - location ?b - bowl ?free - marker)
    :task (t-serve-dish ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (finished-status ?finish)
    )
    :subtasks (and
      (t1 (t-fulfill_ingredient ?p ?i1 ?n1))
      (t2 (t-fulfill_ingredient ?p ?i2 ?n2))
      (t3 (t-get-to ?a ?l-pot))
      (t4 (start-cook ?a ?p ?l-pot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start))
      (t5 (t-cook ?p ?d ?finish))
      (t6 (t-get-item ?a ?b))
      (t7 (t-get-to ?a ?l-pot))
      (t8 (pour-from-pot ?a ?p ?l-pot ?d ?b ?finish ?idle))
      (t9 (t-deliver-dish ?a ?d))
    )
    :ordering (and
      (< t1 t3)
      (< t2 t3)
      (< t3 t4)
      (< t4 t5)
      (< t4 t6)
      (< t5 t8)
      (< t6 t7)
      (< t7 t8)
      (< t8 t9)
    )
  )

  (:method m-fulfill-ingredient-done
    :parameters (?p - pot ?i - ingredient ?count - count)
    :task (t-fulfill_ingredient ?p ?i ?count)
    :precondition (in-pot ?p ?i ?count)
    :subtasks ()
  )

  (:method m-fulfill-ingredient-add
    :parameters (?p - pot ?i - ingredient ?ncurrent ?nnext ?ntarget - count)
    :task (t-fulfill_ingredient ?p ?i ?ntarget)
    :precondition (and
      (in-pot ?p ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
    )
    :ordered-subtasks (and
      (t-add-one-ingredient ?p ?i ?ncurrent ?nnext)
      (t-fulfill_ingredient ?p ?i ?ntarget)
    )
  )

  (:method m-add-one-ingredient
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?ncurrent ?nnext - count ?free - marker ?idle - status)
    :task (t-add-one-ingredient ?p ?i ?ncurrent ?nnext)
    :precondition (pot-status ?p ?idle)
    :ordered-subtasks (and
      (t-get-item ?a ?i)
      (t-get-to ?a ?l)
      (add-to-pot ?a ?p ?l ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  (:method m-cook-done
    :parameters (?p - pot ?d - dish ?finish - status)
    :task (t-cook ?p ?d ?finish)
    :precondition (pot-status ?p ?finish)
    :subtasks ()
  )

  (:method m-cook-step
    :parameters (?p - pot ?d - dish ?s1 ?s2 ?finish - status)
    :task (t-cook ?p ?d ?finish)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :ordered-subtasks (and
      (cook ?p ?s1 ?s2)
      (t-cook ?p ?d ?finish)
    )
  )

  (:method m-get-item-direct
    :parameters (?a - agent ?i - item ?p - pile ?l - location ?free - marker)
    :task (t-get-item ?a ?i)
    :precondition (contains ?p ?i)
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-pile ?a ?p ?l ?i ?free)
    )
  )

  (:method m-get-item-passed
    :parameters (?a1 ?a2 - agent ?i - item ?table - table ?l1 ?l2 - location ?free - marker)
    :task (t-get-item ?a1 ?i)
    :ordered-subtasks (and
      (t-get-item ?a2 ?i)
      (t-get-to ?a2 ?l2)
      (drop-off-to-table ?a2 ?table ?l2 ?i ?free)
      (t-get-to ?a1 ?l1)
      (pick-up-from-table ?a1 ?table ?l1 ?i ?free)
    )
  )

  (:method m-get-item-from-table
    :parameters (?a - agent ?i - item ?table - table ?l - location ?free - marker)
    :task (t-get-item ?a ?i)
    :precondition (holding ?table ?i)
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-table ?a ?table ?l ?i ?free)
    )
  )

  (:method m-deliver-dish-direct
    :parameters (?a - agent ?d - dish ?del - delivery ?l - location ?free - marker)
    :task (t-deliver-dish ?a ?d)
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (drop-off-to-delivery ?a ?del ?l ?d ?free)
    )
  )

  (:method m-deliver-dish-passed
    :parameters (?a1 ?a2 - agent ?d - dish ?table - table ?l1 ?l2 - location ?free - marker)
    :task (t-deliver-dish ?a1 ?d)
    :ordered-subtasks (and
      (t-get-to ?a1 ?l1)
      (drop-off-to-table ?a1 ?table ?l1 ?d ?free)
      (t-get-to ?a2 ?l2)
      (pick-up-from-table ?a2 ?table ?l2 ?d ?free)
      (t-deliver-dish ?a2 ?d)
    )
  )

  (:method m-get-to-already-there
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :subtasks ()
  )

  (:method m-get-to-move
    :parameters (?a - agent ?l-curr ?l-next ?l-goal - location)
    :task (t-get-to ?a ?l-goal)
    :precondition (and (at ?a ?l-curr) (connect ?l-curr ?l-next))
    :ordered-subtasks (and
      (move ?a ?l-curr ?l-next)
      (t-get-to ?a ?l-goal)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)