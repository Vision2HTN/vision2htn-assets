(define (domain overcooked)

  (:requirements :hierarchy :strips :typing)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task t-serve-dish
    :parameters (?d - dish)
  )

  (:task t-fulfill_ingredient
    :parameters (?p - pot ?i - ingredient ?target - count)
  )

  (:task t-add-one-ingredient
    :parameters (?p - pot ?i - ingredient ?ncurrent - count ?nnext - count)
  )

  (:task t-cook
    :parameters (?p - pot ?d - dish ?finish - status)
  )

  (:task t-cook-progress
    :parameters (?p - pot ?finish - status)
  )

  (:task t-plate-and-deliver
    :parameters (?p - pot ?d - dish)
  )

  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  (:method m-serve-dish
    :parameters (?d - dish ?p - pot ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count ?finish - status)
    :task (t-serve-dish ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (finished-status ?finish)
    )
    :subtasks (and
      (t1 (t-fulfill_ingredient ?p ?i1 ?n1))
      (t2 (t-fulfill_ingredient ?p ?i2 ?n2))
      (t3 (t-cook ?p ?d ?finish))
      (t4 (t-plate-and-deliver ?p ?d))
    )
    :ordering (and
      (< t1 t3)
      (< t2 t3)
      (< t3 t4)
    )
  )

  (:method m-fulfill-ingredient-done
    :parameters (?p - pot ?i - ingredient ?target - count)
    :task (t-fulfill_ingredient ?p ?i ?target)
    :precondition (in-pot ?p ?i ?target)
    :ordered-subtasks ()
  )

  (:method m-fulfill-ingredient-step
    :parameters (?p - pot ?i - ingredient ?target - count ?ncurrent - count ?nnext - count)
    :task (t-fulfill_ingredient ?p ?i ?target)
    :precondition (and
      (in-pot ?p ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
    )
    :ordered-subtasks (and
      (t-add-one-ingredient ?p ?i ?ncurrent ?nnext)
      (t-fulfill_ingredient ?p ?i ?target)
    )
  )

  (:method m-add-one-ingredient
    :parameters (?p - pot ?i - ingredient ?ncurrent - count ?nnext - count ?a - agent ?l - location ?free - marker ?idle - status)
    :task (t-add-one-ingredient ?p ?i ?ncurrent ?nnext)
    :precondition (and
      (at ?p ?l)
      (pot-status ?p ?idle)
      (idle-status ?idle)
      (increment ?ncurrent ?nnext)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?i)
      (t-get-to ?a ?l)
      (add-to-pot ?a ?p ?l ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  (:method m-start-and-cook
    :parameters (?p - pot ?d - dish ?finish - status ?a - agent ?l - location ?i1 - ingredient ?i2 - ingredient ?n1 - count ?n2 - count ?zero - count ?free - marker ?idle - status ?start - status)
    :task (t-cook ?p ?d ?finish)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (at ?p ?l)
      (is-zero ?zero)
      (pot-status ?p ?idle)
      (cooking-progress ?idle ?start)
      (finished-status ?finish)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (start-cook ?a ?p ?l ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (t-cook-progress ?p ?finish)
    )
  )

  (:method m-cook-progress-done
    :parameters (?p - pot ?finish - status)
    :task (t-cook-progress ?p ?finish)
    :precondition (pot-status ?p ?finish)
    :ordered-subtasks ()
  )

  (:method m-cook-progress-step
    :parameters (?p - pot ?current - status ?next - status ?finish - status)
    :task (t-cook-progress ?p ?finish)
    :precondition (and
      (pot-status ?p ?current)
      (cooking-progress ?current ?next)
    )
    :ordered-subtasks (and
      (cook ?p ?current ?next)
      (t-cook-progress ?p ?finish)
    )
  )

  (:method m-plate-and-deliver
    :parameters (?p - pot ?d - dish ?a - agent ?l_pot - location ?b - bowl ?finish - status ?idle - status ?del - delivery ?l_del - location ?free - marker)
    :task (t-plate-and-deliver ?p ?d)
    :precondition (and
      (at ?p ?l_pot)
      (at ?del ?l_del)
      (finished-status ?finish)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?b)
      (t-get-to ?a ?l_pot)
      (pour-from-pot ?a ?p ?l_pot ?d ?b ?finish ?idle)
      (t-get-to ?a ?l_del)
      (drop-off-to-delivery ?a ?del ?l_del ?d ?free)
    )
  )

  (:method m-get-to-already-there
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks ()
  )

  (:method m-get-to-adjacent
    :parameters (?a - agent ?l - location ?from - location)
    :task (t-get-to ?a ?l)
    :precondition (and (at ?a ?from) (connect ?from ?l))
    :ordered-subtasks (and
      (move ?a ?from ?l)
    )
  )

  (:method m-get-to-path
    :parameters (?a - agent ?l - location ?from - location ?mid - location)
    :task (t-get-to ?a ?l)
    :precondition (and (at ?a ?from) (connect ?from ?mid))
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-get-to ?a ?l)
    )
  )

  (:method m-get-item-already-holding
    :parameters (?a - agent ?item - item)
    :task (t-get-item ?a ?item)
    :precondition (holding ?a ?item)
    :ordered-subtasks ()
  )

  (:method m-get-item-from-pile
    :parameters (?a - agent ?item - item ?p - pile ?l - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (contains ?p ?item)
      (at ?p ?l)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-pile ?a ?p ?l ?item ?free)
    )
  )

  (:method m-get-item-from-table
    :parameters (?a - agent ?item - item ?table - table ?l - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (holding ?table ?item)
      (reachable ?table ?l)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-table ?a ?table ?l ?item ?free)
    )
  )

  (:method m-get-item-collaborative
    :parameters (?a2 - agent ?item - item ?a1 - agent ?table - table ?l1 - location ?l2 - location ?free1 - marker ?free2 - marker)
    :task (t-get-item ?a2 ?item)
    :precondition (and
      (reachable ?table ?l1)
      (reachable ?table ?l2)
      (holding ?table ?free1)
      (holding ?a2 ?free2)
    )
    :ordered-subtasks (and
      (t-get-item ?a1 ?item)
      (t-get-to ?a1 ?l1)
      (drop-off-to-table ?a1 ?table ?l1 ?item ?free1)
      (t-get-to ?a2 ?l2)
      (pick-up-from-table ?a2 ?table ?l2 ?item ?free1)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )

)