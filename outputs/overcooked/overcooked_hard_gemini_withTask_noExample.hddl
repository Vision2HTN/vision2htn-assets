(define (domain overcooked)
  (:requirements :hierarchy :strips :typing :equality :negative-preconditions)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task t-serve-dish
    :parameters (?dish - dish)
  )

  (:task t-fulfill_ingredient
    :parameters (?pot - pot ?i - ingredient ?count - count)
  )

  (:task t-add-one-ingredient
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count)
  )

  (:task t-cook
    :parameters (?pot - pot ?dish - dish ?current - status ?target - status)
  )

  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  (:method m-serve-dish-single-delivery
    :parameters (?d - dish ?p - pot ?a_cook ?a_serve - agent ?l_pot ?l_del - location
                 ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker
                 ?idle ?start ?finish - status ?b - bowl ?del - delivery)
    :task (t-serve-dish ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (idle-status ?idle)
      (finished-status ?finish)
      (cooking-progress ?idle ?start)
      (at ?p ?l_pot)
      (at ?del ?l_del)
    )
    :ordered-subtasks (and
      (t-fulfill_ingredient ?p ?i1 ?n1)
      (t-fulfill_ingredient ?p ?i2 ?n2)
      (t-get-to ?a_cook ?l_pot)
      (start-cook ?a_cook ?p ?l_pot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (t-cook ?p ?d ?start ?finish)
      (t-get-item ?a_serve ?b)
      (t-get-to ?a_serve ?l_pot)
      (pour-from-pot ?a_serve ?p ?l_pot ?d ?b ?finish ?idle)
      (t-get-to ?a_serve ?l_del)
      (drop-off-to-delivery ?a_serve ?del ?l_del ?d ?free)
    )
  )

  (:method m-serve-dish-collaborative-delivery
    :parameters (?d - dish ?p - pot ?a_cook ?a_pour ?a_deliver - agent
                 ?l_pot ?l_table_pour ?l_table_deliver ?l_del - location
                 ?table - table ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker
                 ?idle ?start ?finish - status ?b - bowl ?del - delivery)
    :task (t-serve-dish ?d)
    :precondition (and
      (not (= ?a_pour ?a_deliver))
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (idle-status ?idle)
      (finished-status ?finish)
      (cooking-progress ?idle ?start)
      (at ?p ?l_pot)
      (at ?del ?l_del)
      (reachable ?table ?l_table_pour)
      (reachable ?table ?l_table_deliver)
    )
    :ordered-subtasks (and
      (t-fulfill_ingredient ?p ?i1 ?n1)
      (t-fulfill_ingredient ?p ?i2 ?n2)
      (t-get-to ?a_cook ?l_pot)
      (start-cook ?a_cook ?p ?l_pot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (t-cook ?p ?d ?start ?finish)
      (t-get-item ?a_pour ?b)
      (t-get-to ?a_pour ?l_pot)
      (pour-from-pot ?a_pour ?p ?l_pot ?d ?b ?finish ?idle)
      (t-get-to ?a_pour ?l_table_pour)
      (drop-off-to-table ?a_pour ?table ?l_table_pour ?d ?free)
      (t-get-to ?a_deliver ?l_table_deliver)
      (pick-up-from-table ?a_deliver ?table ?l_table_deliver ?d ?free)
      (t-get-to ?a_deliver ?l_del)
      (drop-off-to-delivery ?a_deliver ?del ?l_del ?d ?free)
    )
  )

  (:method m-fulfill-ingredient-base
    :parameters (?p - pot ?i - ingredient ?zero - count)
    :task (t-fulfill_ingredient ?p ?i ?zero)
    :precondition (is-zero ?zero)
    :ordered-subtasks ()
  )

  (:method m-fulfill-ingredient-step
    :parameters (?p - pot ?i - ingredient ?nnext ?ncurrent - count)
    :task (t-fulfill_ingredient ?p ?i ?nnext)
    :precondition (increment ?ncurrent ?nnext)
    :ordered-subtasks (and
      (t-fulfill_ingredient ?p ?i ?ncurrent)
      (t-add-one-ingredient ?p ?i ?ncurrent ?nnext)
    )
  )

  (:method m-add-one-ingredient
    :parameters (?p - pot ?i - ingredient ?ncurrent ?nnext - count ?a - agent ?l_pot - location ?free - marker ?idle - status)
    :task (t-add-one-ingredient ?p ?i ?ncurrent ?nnext)
    :precondition (and
      (at ?p ?l_pot)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?i)
      (t-get-to ?a ?l_pot)
      (add-to-pot ?a ?p ?l_pot ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  (:method m-get-item-from-pile-direct
    :parameters (?a - agent ?item - item ?p - pile ?l_pile - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (contains ?p ?item)
      (at ?p ?l_pile)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l_pile)
      (pick-up-from-pile ?a ?p ?l_pile ?item ?free)
    )
  )

  (:method m-get-item-from-table-direct
    :parameters (?a - agent ?item - item ?table - table ?l_table - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (reachable ?table ?l_table)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l_table)
      (pick-up-from-table ?a ?table ?l_table ?item ?free)
    )
  )

  (:method m-get-item-collaborative
    :parameters (?a_receiver ?a_fetcher - agent ?item - item ?table - table
                 ?pile - pile ?l_pile ?l_table_fetch ?l_table_receive - location
                 ?free - marker)
    :task (t-get-item ?a_receiver ?item)
    :precondition (and
      (not (= ?a_receiver ?a_fetcher))
      (contains ?pile ?item)
      (at ?pile ?l_pile)
      (reachable ?table ?l_table_fetch)
      (reachable ?table ?l_table_receive)
    )
    :ordered-subtasks (and
      (t-get-to ?a_fetcher ?l_pile)
      (pick-up-from-pile ?a_fetcher ?pile ?l_pile ?item ?free)
      (t-get-to ?a_fetcher ?l_table_fetch)
      (drop-off-to-table ?a_fetcher ?table ?l_table_fetch ?item ?free)
      (t-get-to ?a_receiver ?l_table_receive)
      (pick-up-from-table ?a_receiver ?table ?l_table_receive ?item ?free)
    )
  )

  (:method m-cook-recursive
    :parameters (?p - pot ?d - dish ?s1 ?s2 ?s_final - status)
    :task (t-cook ?p ?d ?s1 ?s_final)
    :precondition (and
      (cooking-progress ?s1 ?s2)
      (not (= ?s1 ?s_final))
    )
    :ordered-subtasks (and
      (cook ?p ?s1 ?s2)
      (t-cook ?p ?d ?s2 ?s_final)
    )
  )

  (:method m-cook-base
    :parameters (?p - pot ?d - dish ?s - status)
    :task (t-cook ?p ?d ?s ?s)
    :precondition ()
    :ordered-subtasks ()
  )

  (:method m-get-to-already-there
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks ()
  )

  (:method m-get-to-move
    :parameters (?a - agent ?from ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :ordered-subtasks (and
      (move ?a ?from ?to)
    )
  )

  (:method m-get-to-recursive
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and (at ?a ?from) (connect ?from ?mid))
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-get-to ?a ?to)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)