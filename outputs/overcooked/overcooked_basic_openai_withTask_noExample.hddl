(define (domain overcooked)
  (:requirements :hierarchy :strips :typing)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task t-serve-dish
    :parameters (?d - dish)
  )

  (:task t-deliver-dish
    :parameters (?a - agent ?d - dish)
  )

  (:task t-prepare-dish
    :parameters (?a - agent ?p - pot ?d - dish ?finish - status)
  )

  (:task t-fulfill-ingredient
    :parameters (?a - agent ?p - pot ?i - ingredient ?n - count ?free - marker ?idle - status)
  )

  (:task t-add-one-ingredient
    :parameters (?a - agent ?p - pot ?i - ingredient ?ncurrent - count ?nnext - count ?free - marker ?idle - status)
  )

  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  (:task t-get-item
    :parameters (?a - agent ?item - item ?free - marker)
  )

  (:task t-deliver-cooked-dish
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?del - delivery ?free - marker ?finish - status ?idle - status)
  )

  (:task t-assist-ingredient
    :parameters (?a - agent ?p - pot ?i - ingredient ?n - count ?free - marker ?idle - status)
  )

  (:task t-cook-pot
    :parameters (?a - agent ?p - pot ?d - dish ?i1 - ingredient ?i2 - ingredient ?n1 - count ?n2 - count ?zero - count ?free - marker ?idle - status ?start - status ?finish - status)
  )

  (:method m-root-serve-dish-via-pot
    :parameters (?a - agent ?d - dish ?p - pot ?finish - status)
    :task (t-serve-dish ?d)
    :precondition (and
      (finished-status ?finish)
    )
    :ordered-subtasks (and
      (t-prepare-dish ?a ?p ?d ?finish)
      (t-deliver-dish ?a ?d)
    )
  )

  (:method m-serve-dish-from-prepared-pot
    :parameters (?a - agent ?d - dish ?p - pot ?b - bowl ?del - delivery ?free - marker ?finish - status ?idle - status)
    :task (t-deliver-dish ?a ?d)
    :precondition (and
      (finished-status ?finish)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-deliver-cooked-dish ?a ?p ?d ?b ?del ?free ?finish ?idle)
    )
  )

  (:method m-prepare-dish-from-recipe
    :parameters (?a - agent ?p - pot ?d - dish ?i1 - ingredient ?i2 - ingredient ?n1 - count ?n2 - count ?finish - status ?free - marker ?idle - status ?zero - count ?start - status)
    :task (t-prepare-dish ?a ?p ?d ?finish)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (finished-status ?finish)
    )
    :ordered-subtasks (and
      (t-fulfill-ingredient ?a ?p ?i1 ?n1 ?free ?idle)
      (t-fulfill-ingredient ?a ?p ?i2 ?n2 ?free ?idle)
      (t-cook-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start ?finish)
    )
  )

  (:method m-fulfill-ingredient-already-satisfied
    :parameters (?a - agent ?p - pot ?i - ingredient ?n - count ?free - marker ?idle - status)
    :task (t-fulfill-ingredient ?a ?p ?i ?n ?free ?idle)
    :precondition (and
      (in-pot ?p ?i ?n)
    )
    :ordered-subtasks (and
    )
  )

  (:method m-fulfill-ingredient-recursive
    :parameters (?a - agent ?p - pot ?i - ingredient ?ncurrent - count ?nnext - count ?ngoal - count ?free - marker ?idle - status)
    :task (t-fulfill-ingredient ?a ?p ?i ?ngoal ?free ?idle)
    :precondition (and
      (in-pot ?p ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
    )
    :ordered-subtasks (and
      (t-add-one-ingredient ?a ?p ?i ?ncurrent ?nnext ?free ?idle)
      (t-fulfill-ingredient ?a ?p ?i ?ngoal ?free ?idle)
    )
  )

  (:method m-add-one-ingredient-self-sufficient
    :parameters (?a - agent ?p - pot ?i - ingredient ?ncurrent - count ?nnext - count ?pile - pile ?lpile - location ?lpot - location ?free - marker ?idle - status)
    :task (t-add-one-ingredient ?a ?p ?i ?ncurrent ?nnext ?free ?idle)
    :precondition (and
      (at ?p ?lpot)
      (at ?pile ?lpile)
      (contains ?pile ?i)
      (holding ?a ?free)
      (increment ?ncurrent ?nnext)
      (in-pot ?p ?i ?ncurrent)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpile)
      (pick-up-from-pile ?a ?pile ?lpile ?i ?free)
      (t-get-to ?a ?lpot)
      (add-to-pot ?a ?p ?lpot ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  (:method m-add-one-ingredient-assisted-via-table
    :parameters (?a - agent ?p - pot ?i - ingredient ?ncurrent - count ?nnext - count ?table - table ?lpot - location ?free - marker ?idle - status)
    :task (t-add-one-ingredient ?a ?p ?i ?ncurrent ?nnext ?free ?idle)
    :precondition (and
      (at ?p ?lpot)
      (reachable ?table ?lpot)
      (holding ?table ?i)
      (holding ?a ?free)
      (increment ?ncurrent ?nnext)
      (in-pot ?p ?i ?ncurrent)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpot)
      (pick-up-from-table ?a ?table ?lpot ?i ?free)
      (add-to-pot ?a ?p ?lpot ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  (:method m-cook-pot-start-and-progress
    :parameters (?a - agent ?p - pot ?d - dish ?i1 - ingredient ?i2 - ingredient ?n1 - count ?n2 - count ?zero - count ?free - marker ?idle - status ?start - status ?mid - status ?finish - status ?lpot - location)
    :task (t-cook-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start ?finish)
    :precondition (and
      (holding ?a ?free)
      (pot-status ?p ?idle)
      (cooking-progress ?idle ?start)
      (cooking-progress ?start ?mid)
      (cooking-progress ?mid ?finish)
      (finished-status ?finish)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (in-pot ?p ?i1 ?n1)
      (in-pot ?p ?i2 ?n2)
      (is-zero ?zero)
      (at ?p ?lpot)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpot)
      (start-cook ?a ?p ?lpot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (cook ?p ?start ?mid)
      (cook ?p ?mid ?finish)
    )
  )

  (:method m-get-to-already-there
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (and
      (at ?a ?l)
    )
    :ordered-subtasks (and
    )
  )

  (:method m-get-to-one-step
    :parameters (?a - agent ?from - location ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and
      (at ?a ?from)
      (connect ?from ?to)
    )
    :ordered-subtasks (and
      (move ?a ?from ?to)
    )
  )

  (:method m-get-item-from-pile
    :parameters (?a - agent ?item - item ?pile - pile ?lpile - location ?free - marker)
    :task (t-get-item ?a ?item ?free)
    :precondition (and
      (at ?pile ?lpile)
      (contains ?pile ?item)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpile)
      (pick-up-from-pile ?a ?pile ?lpile ?item ?free)
    )
  )

  (:method m-get-item-from-table
    :parameters (?a - agent ?item - item ?table - table ?l - location ?free - marker)
    :task (t-get-item ?a ?item ?free)
    :precondition (and
      (reachable ?table ?l)
      (holding ?table ?item)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-table ?a ?table ?l ?item ?free)
    )
  )

  (:method m-deliver-cooked-dish-direct
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?del - delivery ?free - marker ?finish - status ?idle - status ?lbowl - location ?lpot - location ?ldel - location ?pileb - pile)
    :task (t-deliver-cooked-dish ?a ?p ?d ?b ?del ?free ?finish ?idle)
    :precondition (and
      (at ?p ?lpot)
      (at ?del ?ldel)
      (at ?pileb ?lbowl)
      (contains ?pileb ?b)
      (holding ?a ?free)
      (pot-status ?p ?finish)
      (finished-status ?finish)
      (idle-status ?idle)
      (label-pot-dish ?p ?d)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lbowl)
      (pick-up-from-pile ?a ?pileb ?lbowl ?b ?free)
      (t-get-to ?a ?lpot)
      (pour-from-pot ?a ?p ?lpot ?d ?b ?finish ?idle)
      (t-get-to ?a ?ldel)
      (drop-off-to-delivery ?a ?del ?ldel ?d ?free)
    )
  )

  (:method m-deliver-cooked-dish-bowl-from-table
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?del - delivery ?free - marker ?finish - status ?idle - status ?table - table ?lpot - location ?ldel - location)
    :task (t-deliver-cooked-dish ?a ?p ?d ?b ?del ?free ?finish ?idle)
    :precondition (and
      (at ?p ?lpot)
      (at ?del ?ldel)
      (reachable ?table ?lpot)
      (holding ?table ?b)
      (holding ?a ?free)
      (pot-status ?p ?finish)
      (finished-status ?finish)
      (idle-status ?idle)
      (label-pot-dish ?p ?d)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpot)
      (pick-up-from-table ?a ?table ?lpot ?b ?free)
      (pour-from-pot ?a ?p ?lpot ?d ?b ?finish ?idle)
      (t-get-to ?a ?ldel)
      (drop-off-to-delivery ?a ?del ?ldel ?d ?free)
    )
  )

  (:method m-assist-ingredient-stage-on-table
    :parameters (?a - agent ?p - pot ?i - ingredient ?n - count ?free - marker ?idle - status ?pile - pile ?lpile - location ?table - table ?ltable - location)
    :task (t-assist-ingredient ?a ?p ?i ?n ?free ?idle)
    :precondition (and
      (contains ?pile ?i)
      (at ?pile ?lpile)
      (reachable ?table ?ltable)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?lpile)
      (pick-up-from-pile ?a ?pile ?lpile ?i ?free)
      (t-get-to ?a ?ltable)
      (drop-off-to-table ?a ?table ?ltable ?i ?free)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)