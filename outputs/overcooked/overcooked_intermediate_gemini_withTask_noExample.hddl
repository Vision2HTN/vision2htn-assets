(define (domain overcooked)
  (:requirements :strips :typing :hierarchy)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  ; -----------------------------------------------------------------------
  ; TASKS
  ; -----------------------------------------------------------------------

  ; ROOT TASK. Strongly supported by evidence: The main goal of the demonstration is to prepare and deliver a dish.
  (:task t-serve-dish
    :parameters (?dish - dish)
  )

  ; Plausible generalization: A recursive task to fulfill required ingredient counts for the pot.
  (:task t-fulfill_ingredient
    :parameters (?pot - pot ?i - ingredient ?current - count ?target - count)
  )

  ; Plausible generalization: Add a single ingredient to the pot.
  (:task t-add-one-ingredient
    :parameters (?pot - pot ?i - ingredient ?ncurrent - count ?nnext - count)
  )

  ; Strongly supported by evidence: The cooking process must be started and advanced until finished.
  (:task t-cook
    :parameters (?pot - pot ?dish - dish ?finish - status)
  )

  ; Plausible generalization: Navigational task for agents.
  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  ; Plausible generalization: Task for acquiring an item from its pile.
  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  ; Strongly supported by evidence: Intermediate task for an agent passing an item onto a table.
  (:task t-bring-to-table
    :parameters (?a - agent ?t - table ?i - item ?free_t - marker)
  )

  ; Strongly supported by evidence: The final sequence of plating the food and bringing it to delivery.
  (:task t-plate-and-deliver
    :parameters (?pot - pot ?dish - dish)
  )

  ; -----------------------------------------------------------------------
  ; METHODS
  ; -----------------------------------------------------------------------

  ; Plausible generalization: Main sequence to serve a dish.
  (:method m-serve-dish
    :parameters (?dish - dish ?pot - pot ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?finish - status)
    :task (t-serve-dish ?dish)
    :precondition (and
      (recipe ?dish ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (finished-status ?finish)
    )
    :ordered-subtasks (and
      (t-fulfill_ingredient ?pot ?i1 ?zero ?n1)
      (t-fulfill_ingredient ?pot ?i2 ?zero ?n2)
      (t-cook ?pot ?dish ?finish)
      (t-plate-and-deliver ?pot ?dish)
    )
  )

  ; Plausible generalization: Base case for ingredient fulfillment.
  (:method m-fulfill-ingredient-done
    :parameters (?pot - pot ?i - ingredient ?target - count)
    :task (t-fulfill_ingredient ?pot ?i ?target ?target)
    :precondition ()
    :ordered-subtasks ()
  )

  ; Plausible generalization: Recursive step for ingredient fulfillment.
  (:method m-fulfill-ingredient-more
    :parameters (?pot - pot ?i - ingredient ?current ?next ?target - count)
    :task (t-fulfill_ingredient ?pot ?i ?current ?target)
    :precondition (increment ?current ?next)
    :ordered-subtasks (and
      (t-add-one-ingredient ?pot ?i ?current ?next)
      (t-fulfill_ingredient ?pot ?i ?next ?target)
    )
  )

  ; Plausible generalization: Agent directly retrieves an ingredient and places it into the pot.
  (:method m-add-one-direct
    :parameters (?a - agent ?pot - pot ?i - ingredient ?ncurrent ?nnext - count ?l-pot - location ?free_a - marker ?idle - status)
    :task (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
    :precondition (and 
      (at ?pot ?l-pot)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?i)
      (t-get-to ?a ?l-pot)
      (add-to-pot ?a ?pot ?l-pot ?i ?ncurrent ?nnext ?free_a ?idle)
    )
  )

  ; Strongly supported by evidence: Forced coordination where Agent 1 brings ingredient to the table, and Agent 2 takes it to the pot.
  (:method m-add-one-passed
    :parameters (?a1 ?a2 - agent ?pot - pot ?i - ingredient ?ncurrent ?nnext - count ?t - table ?l-t2 ?l-pot - location ?free_a2 ?free_t - marker ?idle - status)
    :task (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
    :precondition (and
      (at ?pot ?l-pot)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (reachable ?t ?l-t2)
    )
    :ordered-subtasks (and
      (t-bring-to-table ?a1 ?t ?i ?free_t)
      (t-get-to ?a2 ?l-t2)
      (pick-up-from-table ?a2 ?t ?l-t2 ?i ?free_a2)
      (t-get-to ?a2 ?l-pot)
      (add-to-pot ?a2 ?pot ?l-pot ?i ?ncurrent ?nnext ?free_a2 ?idle)
    )
  )

  ; Strongly supported by evidence: Agent handles the actual cooking process once ingredients are fulfilled.
  (:method m-cook-dish
    :parameters (?a - agent ?pot - pot ?dish - dish ?finish - status ?l-pot - location ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free_a - marker ?idle ?start - status)
    :task (t-cook ?pot ?dish ?finish)
    :precondition (and 
      (recipe ?dish ?i1 ?n1 ?i2 ?n2)
      (in-pot ?pot ?i1 ?n1)
      (in-pot ?pot ?i2 ?n2)
      (at ?pot ?l-pot)
      (pot-status ?pot ?idle)
      (cooking-progress ?idle ?start)
      (cooking-progress ?start ?finish)
      (finished-status ?finish)
      (is-zero ?zero)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l-pot)
      (start-cook ?a ?pot ?l-pot ?dish ?i1 ?i2 ?n1 ?n2 ?zero ?free_a ?idle ?start)
      (cook ?pot ?start ?finish)
    )
  )

  ; Plausible generalization: One agent acts independently to acquire a bowl, plate the food, and deliver it.
  (:method m-plate-and-deliver-direct
    :parameters (?a - agent ?pot - pot ?dish - dish ?b - bowl ?l-pot ?l-del - location ?del - delivery ?free_a - marker ?finish ?idle - status)
    :task (t-plate-and-deliver ?pot ?dish)
    :precondition (and
      (at ?pot ?l-pot)
      (at ?del ?l-del)
      (pot-status ?pot ?finish)
      (finished-status ?finish)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-get-item ?a ?b)
      (t-get-to ?a ?l-pot)
      (pour-from-pot ?a ?pot ?l-pot ?dish ?b ?finish ?idle)
      (t-get-to ?a ?l-del)
      (drop-off-to-delivery ?a ?del ?l-del ?dish ?free_a)
    )
  )

  ; Strongly supported by evidence: Agent 1 passes a bowl via the table, Agent 2 pours the dish and returns it via the table, Agent 1 delivers.
  (:method m-plate-and-deliver-passed
    :parameters (?a1 ?a2 - agent ?pot - pot ?dish - dish ?b - bowl ?t - table ?l-pot ?l-del ?l-t1 ?l-t2 - location ?del - delivery ?free_a1 ?free_a2 ?free_t - marker ?finish ?idle - status)
    :task (t-plate-and-deliver ?pot ?dish)
    :precondition (and
      (at ?pot ?l-pot)
      (at ?del ?l-del)
      (pot-status ?pot ?finish)
      (finished-status ?finish)
      (idle-status ?idle)
      (reachable ?t ?l-t1)
      (reachable ?t ?l-t2)
    )
    :ordered-subtasks (and
      (t-bring-to-table ?a1 ?t ?b ?free_t)
      (t-get-to ?a2 ?l-t2)
      (pick-up-from-table ?a2 ?t ?l-t2 ?b ?free_a2)
      (t-get-to ?a2 ?l-pot)
      (pour-from-pot ?a2 ?pot ?l-pot ?dish ?b ?finish ?idle)
      (t-get-to ?a2 ?l-t2)
      (drop-off-to-table ?a2 ?t ?l-t2 ?dish ?free_t)
      (t-get-to ?a1 ?l-t1)
      (pick-up-from-table ?a1 ?t ?l-t1 ?dish ?free_a1)
      (t-get-to ?a1 ?l-del)
      (drop-off-to-delivery ?a1 ?del ?l-del ?dish ?free_a1)
    )
  )

  ; Plausible generalization: Abstraction for placing an item on the table.
  (:method m-bring-to-table
    :parameters (?a - agent ?t - table ?i - item ?l-t - location ?free_t - marker)
    :task (t-bring-to-table ?a ?t ?i ?free_t)
    :precondition (reachable ?t ?l-t)
    :ordered-subtasks (and
      (t-get-item ?a ?i)
      (t-get-to ?a ?l-t)
      (drop-off-to-table ?a ?t ?l-t ?i ?free_t)
    )
  )

  ; Plausible generalization: Base case for movement (already at destination).
  (:method m-already-there
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks ()
  )

  ; Plausible generalization: One-step movement.
  (:method m-move
    :parameters (?a - agent ?from ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :ordered-subtasks (and
      (move ?a ?from ?to)
    )
  )

  ; Plausible generalization: Recursive multi-step movement.
  (:method m-move-multi
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and (at ?a ?from) (connect ?from ?mid))
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-get-to ?a ?to)
    )
  )

  ; Plausible generalization: Agent navigates to a pile and picks up an item.
  (:method m-get-item-pile
    :parameters (?a - agent ?item - item ?p - pile ?l-p - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and (contains ?p ?item) (at ?p ?l-p))
    :ordered-subtasks (and
      (t-get-to ?a ?l-p)
      (pick-up-from-pile ?a ?p ?l-p ?item ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; ACTIONS
  ; -----------------------------------------------------------------------

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )
  
  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )
  
  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )
  
  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)
