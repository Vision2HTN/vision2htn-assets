(define (domain overcooked)

  (:requirements :hierarchy :strips :typing)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  ; ROOT TASK: deliver a dish of a given type
  (:task root-deliver-dish
    :parameters (?d - dish)
  )

  ; Task: navigate agent to a target location
  (:task t-go-to
    :parameters (?a - agent ?to - location)
  )

  ; Task: obtain an ingredient from a pile and hold it
  (:task t-obtain-ingredient
    :parameters (?a - agent ?i - ingredient)
  )

  ; Task: place an ingredient into a pot
  (:task t-add-ingredient-to-pot
    :parameters (?a - agent ?p - pot ?i - ingredient)
  )

  ; Task: cook a dish in a pot (start cooking and wait until finished)
  (:task t-cook-dish
    :parameters (?a - agent ?p - pot ?d - dish)
  )

  ; Task: collect finished dish from pot into bowl
  (:task t-collect-from-pot
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl)
  )

  ; Task: deliver a held dish to the delivery station
  (:task t-deliver
    :parameters (?a - agent ?d - dish ?del - delivery)
  )

  ; Task: load the required ingredients into a pot according to a two-ingredient recipe
  (:task t-load-pot
    :parameters (?a - agent ?p - pot ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 - count)
  )

  ; -----------------------------------------------------------------------
  ; MOVEMENT METHODS
  ; Observed: agents move step by step around the circuit.
  ; Generalises: any agent navigating between any two connected locations.
  ; -----------------------------------------------------------------------

  ; Base case: agent is already at destination
  (:method m-go-to-done
    :parameters (?a - agent ?l - location)
    :task (t-go-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks ()
  )

  ; Recursive case: move one step then continue
  (:method m-go-to-step
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (t-go-to ?a ?to)
    :precondition (and
      (at ?a ?from)
      (connect ?from ?mid)
      (not (= ?from ?to))
    )
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-go-to ?a ?to)
    )
  )

  ; -----------------------------------------------------------------------
  ; OBTAIN INGREDIENT METHODS
  ; Observed: agent walks to pile location and picks up onion.
  ; Generalises: any ingredient from any pile.
  ; -----------------------------------------------------------------------

  (:method m-obtain-ingredient-from-pile
    :parameters (?a - agent ?i - ingredient ?pile - pile ?l - location ?free - marker)
    :task (t-obtain-ingredient ?a ?i)
    :precondition (and
      (at ?pile ?l)
      (contains ?pile ?i)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-go-to ?a ?l)
      (pick-up-from-pile ?a ?pile ?l ?i ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; ADD INGREDIENT TO POT METHODS
  ; Observed: agent carries onion to pot location and drops it in.
  ; Generalises: any ingredient, any pot.
  ; -----------------------------------------------------------------------

  (:method m-add-ingredient-to-pot
    :parameters (?a - agent ?p - pot ?i - ingredient ?l - location ?n1 ?n2 - count ?free - marker ?idle - status)
    :task (t-add-ingredient-to-pot ?a ?p ?i)
    :precondition (and
      (at ?p ?l)
      (holding ?a ?i)
      (in-pot ?p ?i ?n1)
      (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-go-to ?a ?l)
      (add-to-pot ?a ?p ?l ?i ?n1 ?n2 ?free ?idle)
    )
  )

  ; -----------------------------------------------------------------------
  ; LOAD POT METHODS
  ; Observed: both chefs pick up onions and add them to pots (two-ingredient scenario).
  ; Generalises: any two-ingredient recipe requiring n1 of i1 and n2 of i2.
  ; The two-ingredient base case loads ingredient i1 once then i2 once;
  ; recursive variants handle counts > 1 (tentative generalisation).
  ; -----------------------------------------------------------------------

  ; Base: both ingredients already at required counts - nothing to do
  (:method m-load-pot-done
    :parameters (?a - agent ?p - pot ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count)
    :task (t-load-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2)
    :precondition (and
      (in-pot ?p ?i1 ?n1)
      (in-pot ?p ?i2 ?n2)
      (is-zero ?zero)
    )
    :ordered-subtasks ()
  )

  ; Add one unit of i1 then continue loading
  (:method m-load-pot-add-i1
    :parameters (?a - agent ?p - pot ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?cur1 ?next1 - count)
    :task (t-load-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2)
    :precondition (and
      (in-pot ?p ?i1 ?cur1)
      (increment ?cur1 ?next1)
      (not (= ?cur1 ?n1))
    )
    :ordered-subtasks (and
      (t-obtain-ingredient ?a ?i1)
      (t-add-ingredient-to-pot ?a ?p ?i1)
      (t-load-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2)
    )
  )

  ; Add one unit of i2 then continue loading (tentative: mirrors i1 variant)
  (:method m-load-pot-add-i2
    :parameters (?a - agent ?p - pot ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?cur2 ?next2 - count)
    :task (t-load-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2)
    :precondition (and
      (in-pot ?p ?i1 ?n1)
      (in-pot ?p ?i2 ?cur2)
      (increment ?cur2 ?next2)
      (not (= ?cur2 ?n2))
    )
    :ordered-subtasks (and
      (t-obtain-ingredient ?a ?i2)
      (t-add-ingredient-to-pot ?a ?p ?i2)
      (t-load-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2)
    )
  )

  ; -----------------------------------------------------------------------
  ; COOK DISH METHODS
  ; Observed: after both onions added, agent starts cooking; pot ticks down.
  ; Generalises: any pot/dish; cook action advances status until finished.
  ; -----------------------------------------------------------------------

  ; Start cooking and then advance cooking progress until done
  (:method m-cook-dish-start
    :parameters (?a - agent ?p - pot ?d - dish ?l - location ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :task (t-cook-dish ?a ?p ?d)
    :precondition (and
      (at ?p ?l)
      (pot-status ?p ?idle)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1)
      (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :ordered-subtasks (and
      (t-go-to ?a ?l)
      (start-cook ?a ?p ?l ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (t-advance-cooking ?p ?d)
    )
  )

  ; Task: advance cooking progress until finished
  (:task t-advance-cooking
    :parameters (?p - pot ?d - dish)
  )

  ; Cooking still in progress - advance one step
  (:method m-advance-cooking-step
    :parameters (?p - pot ?d - dish ?s1 ?s2 - status)
    :task (t-advance-cooking ?p ?d)
    :precondition (and
      (pot-status ?p ?s1)
      (cooking-progress ?s1 ?s2)
      (not (finished-status ?s1))
    )
    :ordered-subtasks (and
      (cook ?p ?s1 ?s2)
      (t-advance-cooking ?p ?d)
    )
  )

  ; Cooking finished - nothing more to do
  (:method m-advance-cooking-done
    :parameters (?p - pot ?d - dish ?s - status)
    :task (t-advance-cooking ?p ?d)
    :precondition (and
      (pot-status ?p ?s)
      (finished-status ?s)
    )
    :ordered-subtasks ()
  )

  ; -----------------------------------------------------------------------
  ; COLLECT FROM POT METHODS
  ; Observed: agent holds bowl, walks to pot, pours finished dish.
  ; Generalises: any agent, any pot, any dish, any bowl.
  ; -----------------------------------------------------------------------

  (:method m-collect-from-pot
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?l - location ?finish ?idle - status)
    :task (t-collect-from-pot ?a ?p ?d ?b)
    :precondition (and
      (at ?p ?l)
      (pot-status ?p ?finish)
      (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
      (holding ?a ?b)
    )
    :ordered-subtasks (and
      (t-go-to ?a ?l)
      (pour-from-pot ?a ?p ?l ?d ?b ?finish ?idle)
    )
  )

  ; -----------------------------------------------------------------------
  ; DELIVER METHODS
  ; Observed: agent carries completed dish to delivery station and drops it.
  ; Generalises: any agent, any dish, any delivery location.
  ; -----------------------------------------------------------------------

  (:method m-deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery ?l - location ?free - marker)
    :task (t-deliver ?a ?d ?del)
    :precondition (and
      (at ?del ?l)
      (holding ?a ?d)
    )
    :ordered-subtasks (and
      (t-go-to ?a ?l)
      (drop-off-to-delivery ?a ?del ?l ?d ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; ROOT TASK METHODS
  ; Observed: full pipeline - pick onions, add to pot, cook, collect, deliver.
  ; Generalises: any two-ingredient recipe cooked in any pot and delivered.
  ; Single-agent variant: one agent handles all steps.
  ; -----------------------------------------------------------------------

  (:method m-root-deliver-dish-single-agent
    :parameters (?a - agent ?d - dish ?p - pot ?del - delivery
                 ?i1 ?i2 - ingredient ?n1 ?n2 - count
                 ?b - bowl ?free - marker)
    :task (root-deliver-dish ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
    )
    :ordered-subtasks (and
      (t-load-pot ?a ?p ?d ?i1 ?i2 ?n1 ?n2)
      (t-cook-dish ?a ?p ?d)
      (t-collect-from-pot ?a ?p ?d ?b)
      (t-deliver ?a ?d ?del)
    )
  )

  ; -----------------------------------------------------------------------
  ; ACTIONS (copied verbatim from PDDL domain)
  ; -----------------------------------------------------------------------

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )

)
