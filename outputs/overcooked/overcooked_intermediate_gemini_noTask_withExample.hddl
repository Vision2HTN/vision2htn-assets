(define (domain overcooked)

  (:requirements :strips :typing :hierarchy :equality)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task serve-dish
    :parameters (?d - dish)
  )

  (:task prepare-and-cook
    :parameters (?p - pot ?d - dish)
  )

  (:task fill-pot
    :parameters (?p - pot ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
  )

  (:task add-ingredient-multiple
    :parameters (?p - pot ?i - ingredient ?target - count)
  )

  (:task add-one-ingredient
    :parameters (?a - agent ?p - pot ?i - ingredient)
  )

  (:task cook-pot
    :parameters (?p - pot ?current_s ?target_s - status)
  )

  (:task plate-dish
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl)
  )

  (:task deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery)
  )

  (:task acquire-item
    :parameters (?a - agent ?i - item)
  )

  (:task pass-item
    :parameters (?a - agent ?table - table ?i - item)
  )

  (:task navigate
    :parameters (?a - agent ?to - location)
  )

  (:method m-serve-dish
    :parameters (?d - dish ?p - pot ?a_plate - agent ?a_del - agent ?b - bowl ?del - delivery)
    :task (serve-dish ?d)
    :ordered-subtasks (and
      (prepare-and-cook ?p ?d)
      (plate-dish ?a_plate ?p ?d ?b)
      (deliver-dish ?a_del ?d ?del)
    )
  )

  (:method m-prepare-and-cook
    :parameters (?p - pot ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start ?finished - status ?a_start - agent ?l_pot - location)
    :task (prepare-and-cook ?p ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (at ?p ?l_pot)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (finished-status ?finished)
      (is-zero ?zero)
    )
    :ordered-subtasks (and
      (fill-pot ?p ?i1 ?n1 ?i2 ?n2)
      (navigate ?a_start ?l_pot)
      (start-cook ?a_start ?p ?l_pot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (cook-pot ?p ?start ?finished)
    )
  )

  (:method m-fill-pot
    :parameters (?p - pot ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    :task (fill-pot ?p ?i1 ?n1 ?i2 ?n2)
    :subtasks (and
      (t1 (add-ingredient-multiple ?p ?i1 ?n1))
      (t2 (add-ingredient-multiple ?p ?i2 ?n2))
    )
  )

  (:method m-add-ing-done
    :parameters (?p - pot ?i - ingredient ?target - count)
    :task (add-ingredient-multiple ?p ?i ?target)
    :precondition (in-pot ?p ?i ?target)
    :subtasks ()
  )

  (:method m-add-ing-step
    :parameters (?p - pot ?i - ingredient ?target ?current ?next - count ?a - agent)
    :task (add-ingredient-multiple ?p ?i ?target)
    :precondition (and
      (in-pot ?p ?i ?current)
      (increment ?current ?next)
    )
    :ordered-subtasks (and
      (add-one-ingredient ?a ?p ?i)
      (add-ingredient-multiple ?p ?i ?target)
    )
  )

  (:method m-add-one-ing
    :parameters (?a - agent ?p - pot ?i - ingredient ?l_pot - location ?n1 ?n2 - count ?free - marker ?idle - status)
    :task (add-one-ingredient ?a ?p ?i)
    :precondition (and
      (at ?p ?l_pot)
      (in-pot ?p ?i ?n1)
      (increment ?n1 ?n2)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (acquire-item ?a ?i)
      (navigate ?a ?l_pot)
      (add-to-pot ?a ?p ?l_pot ?i ?n1 ?n2 ?free ?idle)
    )
  )

  (:method m-cook-pot-done
    :parameters (?p - pot ?s - status)
    :task (cook-pot ?p ?s ?s)
    :subtasks ()
  )

  (:method m-cook-pot-step
    :parameters (?p - pot ?s1 ?s2 ?target - status)
    :task (cook-pot ?p ?s1 ?target)
    :precondition (cooking-progress ?s1 ?s2)
    :ordered-subtasks (and
      (cook ?p ?s1 ?s2)
      (cook-pot ?p ?s2 ?target)
    )
  )

  (:method m-plate-dish
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?l_pot - location ?finished ?idle - status)
    :task (plate-dish ?a ?p ?d ?b)
    :precondition (and
      (at ?p ?l_pot)
      (finished-status ?finished)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (acquire-item ?a ?b)
      (navigate ?a ?l_pot)
      (pour-from-pot ?a ?p ?l_pot ?d ?b ?finished ?idle)
    )
  )

  (:method m-deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery ?l_del - location ?free - marker)
    :task (deliver-dish ?a ?d ?del)
    :precondition (at ?del ?l_del)
    :ordered-subtasks (and
      (navigate ?a ?l_del)
      (drop-off-to-delivery ?a ?del ?l_del ?d ?free)
    )
  )

  (:method m-acquire-direct
    :parameters (?a - agent ?i - item ?pile - pile ?l_pile - location ?free - marker)
    :task (acquire-item ?a ?i)
    :precondition (and
      (contains ?pile ?i)
      (at ?pile ?l_pile)
    )
    :ordered-subtasks (and
      (navigate ?a ?l_pile)
      (pick-up-from-pile ?a ?pile ?l_pile ?i ?free)
    )
  )

  (:method m-acquire-collaborative
    :parameters (?a_receiver - agent ?i - item ?a_fetcher - agent ?table - table ?l_recv - location ?free - marker)
    :task (acquire-item ?a_receiver ?i)
    :precondition (and
      (not (= ?a_receiver ?a_fetcher))
      (reachable ?table ?l_recv)
    )
    :ordered-subtasks (and
      (pass-item ?a_fetcher ?table ?i)
      (navigate ?a_receiver ?l_recv)
      (pick-up-from-table ?a_receiver ?table ?l_recv ?i ?free)
    )
  )

  (:method m-pass-item
    :parameters (?a - agent ?table - table ?i - item ?l_drop - location ?free_table - marker)
    :task (pass-item ?a ?table ?i)
    :precondition (reachable ?table ?l_drop)
    :ordered-subtasks (and
      (acquire-item ?a ?i)
      (navigate ?a ?l_drop)
      (drop-off-to-table ?a ?table ?l_drop ?i ?free_table)
    )
  )

  (:method m-nav-base
    :parameters (?a - agent ?to - location)
    :task (navigate ?a ?to)
    :precondition (at ?a ?to)
    :subtasks ()
  )

  (:method m-nav-step
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (navigate ?a ?to)
    :precondition (and
      (not (= ?from ?to))
      (at ?a ?from)
      (connect ?from ?mid)
    )
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (navigate ?a ?to)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )

)