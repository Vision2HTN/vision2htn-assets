(define (domain overcooked)
  (:requirements :hierarchy :typing :equality :negative-preconditions)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task serve-order
    :parameters (?d - dish)
  )

  (:task fill-pot-with-ingredient
    :parameters (?p - pot ?i - ingredient ?target - count)
  )

  (:task add-one-ingredient-to-pot
    :parameters (?p - pot ?i - ingredient ?n1 - count ?n2 - count)
  )

  (:task obtain-item
    :parameters (?a - agent ?i - item)
  )

  (:task navigate
    :parameters (?a - agent ?to - location)
  )

  (:task start-cooking
    :parameters (?p - pot ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
  )

  (:task wait-for-cooking
    :parameters (?p - pot)
  )

  (:task finish-and-deliver
    :parameters (?p - pot ?d - dish)
  )

  (:task plate-dish
    :parameters (?a - agent ?p - pot ?d - dish)
  )

  (:task deliver-held-dish
    :parameters (?a - agent ?d - dish)
  )

  (:method serve-order-method
    :parameters (?p - pot ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count ?zero - count ?idle ?start ?finish - status)
    :task (serve-order ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (pot-status ?p ?idle)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (finished-status ?finish)
    )
    :ordered-subtasks (and
      (fill-pot-with-ingredient ?p ?i1 ?n1)
      (fill-pot-with-ingredient ?p ?i2 ?n2)
      (start-cooking ?p ?d ?i1 ?n1 ?i2 ?n2)
      (wait-for-cooking ?p)
      (finish-and-deliver ?p ?d)
    )
  )

  (:method fill-pot-base
    :parameters (?p - pot ?i - ingredient ?target - count)
    :task (fill-pot-with-ingredient ?p ?i ?target)
    :precondition (and (in-pot ?p ?i ?target))
    :ordered-subtasks ()
  )

  (:method fill-pot-step
    :parameters (?p - pot ?i - ingredient ?target - count ?current - count ?next - count)
    :task (fill-pot-with-ingredient ?p ?i ?target)
    :precondition (and
      (in-pot ?p ?i ?current)
      (not (= ?current ?target))
      (increment ?current ?next)
    )
    :ordered-subtasks (and
      (add-one-ingredient-to-pot ?p ?i ?current ?next)
      (fill-pot-with-ingredient ?p ?i ?target)
    )
  )

  (:method add-one-ingredient-method
    :parameters (?a - agent ?p - pot ?i - ingredient ?n1 ?n2 - count ?l_pot - location ?free - marker ?idle - status)
    :task (add-one-ingredient-to-pot ?p ?i ?n1 ?n2)
    :precondition (and
      (at ?p ?l_pot)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (obtain-item ?a ?i)
      (navigate ?a ?l_pot)
      (add-to-pot ?a ?p ?l_pot ?i ?n1 ?n2 ?free ?idle)
    )
  )

  (:method obtain-item-already-holding
    :parameters (?a - agent ?i - item)
    :task (obtain-item ?a ?i)
    :precondition (and (holding ?a ?i))
    :ordered-subtasks ()
  )

  (:method obtain-item-direct
    :parameters (?a - agent ?i - item ?pile - pile ?l_pile - location ?free - marker)
    :task (obtain-item ?a ?i)
    :precondition (and
      (contains ?pile ?i)
      (at ?pile ?l_pile)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (navigate ?a ?l_pile)
      (pick-up-from-pile ?a ?pile ?l_pile ?i ?free)
    )
  )

  (:method obtain-item-from-table
    :parameters (?a - agent ?i - item ?table - table ?l_table - location ?free - marker)
    :task (obtain-item ?a ?i)
    :precondition (and
      (holding ?table ?i)
      (reachable ?table ?l_table)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (navigate ?a ?l_table)
      (pick-up-from-table ?a ?table ?l_table ?i ?free)
    )
  )

  (:method obtain-item-collaborative
    :parameters (?a ?a_helper - agent ?i - item ?pile - pile ?table - table ?l_pile ?l_table1 ?l_table2 - location ?f1 ?f2 ?f3 - marker)
    :task (obtain-item ?a ?i)
    :precondition (and
      (not (= ?a ?a_helper))
      (contains ?pile ?i)
      (at ?pile ?l_pile)
      (reachable ?table ?l_table1)
      (reachable ?table ?l_table2)
      (holding ?a ?f1)
      (holding ?a_helper ?f2)
      (holding ?table ?f3)
    )
    :ordered-subtasks (and
      (navigate ?a_helper ?l_pile)
      (pick-up-from-pile ?a_helper ?pile ?l_pile ?i ?f2)
      (navigate ?a_helper ?l_table1)
      (drop-off-to-table ?a_helper ?table ?l_table1 ?i ?f3)
      (navigate ?a ?l_table2)
      (pick-up-from-table ?a ?table ?l_table2 ?i ?f1)
    )
  )

  (:method nav-base
    :parameters (?a - agent ?to - location)
    :task (navigate ?a ?to)
    :precondition (and (at ?a ?to))
    :ordered-subtasks ()
  )

  (:method nav-step
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (navigate ?a ?to)
    :precondition (and (at ?a ?from) (connect ?from ?mid) (not (= ?from ?to)))
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (navigate ?a ?to)
    )
  )

  (:method start-cooking-method
    :parameters (?a - agent ?p - pot ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count ?l_pot - location ?zero - count ?free - marker ?idle ?start - status)
    :task (start-cooking ?p ?d ?i1 ?n1 ?i2 ?n2)
    :precondition (and
      (at ?p ?l_pot)
      (is-zero ?zero)
      (pot-status ?p ?idle)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (navigate ?a ?l_pot)
      (start-cook ?a ?p ?l_pot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
    )
  )

  (:method wait-cooking-base
    :parameters (?p - pot ?finish - status)
    :task (wait-for-cooking ?p)
    :precondition (and
      (pot-status ?p ?finish)
      (finished-status ?finish)
    )
    :ordered-subtasks ()
  )

  (:method wait-cooking-step
    :parameters (?p - pot ?s1 ?s2 - status)
    :task (wait-for-cooking ?p)
    :precondition (and
      (pot-status ?p ?s1)
      (not (finished-status ?s1))
      (cooking-progress ?s1 ?s2)
    )
    :ordered-subtasks (and
      (cook ?p ?s1 ?s2)
      (wait-for-cooking ?p)
    )
  )

  (:method finish-and-deliver-method
    :parameters (?a - agent ?p - pot ?d - dish)
    :task (finish-and-deliver ?p ?d)
    :precondition ()
    :ordered-subtasks (and
      (plate-dish ?a ?p ?d)
      (deliver-held-dish ?a ?d)
    )
  )

  (:method plate-dish-method
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?l_pot - location ?finish ?idle - status)
    :task (plate-dish ?a ?p ?d)
    :precondition (and
      (at ?p ?l_pot)
      (pot-status ?p ?finish)
      (finished-status ?finish)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (obtain-item ?a ?b)
      (navigate ?a ?l_pot)
      (pour-from-pot ?a ?p ?l_pot ?d ?b ?finish ?idle)
    )
  )

  (:method deliver-direct
    :parameters (?a - agent ?d - dish ?del - delivery ?l_del - location ?free - marker)
    :task (deliver-held-dish ?a ?d)
    :precondition (and
      (holding ?a ?d)
      (at ?del ?l_del)
    )
    :ordered-subtasks (and
      (navigate ?a ?l_del)
      (drop-off-to-delivery ?a ?del ?l_del ?d ?free)
    )
  )

  (:method deliver-collaborative
    :parameters (?a ?a_helper - agent ?d - dish ?table - table ?l_table1 - location ?f_table ?f_any - marker ?del - delivery ?l_del - location)
    :task (deliver-held-dish ?a ?d)
    :precondition (and
      (not (= ?a ?a_helper))
      (holding ?a ?d)
      (reachable ?table ?l_table1)
      (holding ?table ?f_table)
      (at ?del ?l_del)
    )
    :ordered-subtasks (and
      (navigate ?a ?l_table1)
      (drop-off-to-table ?a ?table ?l_table1 ?d ?f_table)
      (obtain-item ?a_helper ?d)
      (navigate ?a_helper ?l_del)
      (drop-off-to-delivery ?a_helper ?del ?l_del ?d ?f_any)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)