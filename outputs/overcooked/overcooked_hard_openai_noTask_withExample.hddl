(define (domain overcooked)
  (:requirements :hierarchy :strips :typing)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task root-deliver-dish
    :parameters (?d - dish)
  )

  (:task root-produce-dish
    :parameters (?d - dish)
  )

  (:task prepare-and-deliver-dish
    :parameters (?d - dish ?del - delivery)
  )

  (:task prepare-dish
    :parameters (?d - dish)
  )

  (:task cook-dish-in-pot
    :parameters (?d - dish ?p - pot)
  )

  (:task collect-ingredient-for-pot
    :parameters (?a - agent ?p - pot ?i - ingredient ?target - count)
  )

  (:task fetch-item
    :parameters (?a - agent ?item - item)
  )

  (:task bring-item-to-pot
    :parameters (?a - agent ?p - pot ?i - ingredient)
  )

  (:task plate-dish
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl)
  )

  (:task deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery)
  )

  (:task t-move
    :parameters (?a - agent ?to - location)
  )

  (:task start-cooking-process
    :parameters (?d - dish ?p - pot)
  )

  (:task finish-cooking
    :parameters (?p - pot ?s - status)
  )

  (:method m-root-deliver-direct
    :parameters (?d - dish ?del - delivery ?a - agent ?l - location ?free - marker)
    :task (root-deliver-dish ?d)
    :precondition (and
      (holding ?a ?d)
      (at ?a ?l)
      (at ?del ?l)
    )
    :ordered-subtasks (and
      (drop-off-to-delivery ?a ?del ?l ?d ?free)
    )
  )

  (:method m-root-deliver-prepare-then-deliver
    :parameters (?d - dish ?del - delivery)
    :task (root-deliver-dish ?d)
    :ordered-subtasks (and
      (prepare-and-deliver-dish ?d ?del)
    )
  )

  (:method m-root-produce-dish
    :parameters (?d - dish)
    :task (root-produce-dish ?d)
    :ordered-subtasks (and
      (prepare-dish ?d)
    )
  )

  (:method m-prepare-and-deliver-single-agent
    :parameters (?d - dish ?del - delivery ?a - agent ?p - pot ?b - bowl)
    :task (prepare-and-deliver-dish ?d ?del)
    :ordered-subtasks (and
      (cook-dish-in-pot ?d ?p)
      (plate-dish ?a ?p ?d ?b)
      (deliver-dish ?a ?d ?del)
    )
  )

  (:method m-prepare-and-deliver-collaborative
    :parameters (?d - dish ?del - delivery ?a1 ?a2 - agent ?p - pot ?b - bowl)
    :task (prepare-and-deliver-dish ?d ?del)
    :ordered-subtasks (and
      (prepare-dish ?d)
      (plate-dish ?a1 ?p ?d ?b)
      (deliver-dish ?a1 ?d ?del)
    )
  )

  (:method m-prepare-dish-at-pot
    :parameters (?d - dish ?p - pot)
    :task (prepare-dish ?d)
    :ordered-subtasks (and
      (cook-dish-in-pot ?d ?p)
    )
  )

  (:method m-cook-dish-same-ingredient-twice
    :parameters (?d - dish ?p - pot ?a1 ?a2 - agent ?i - ingredient ?n0 ?n1 ?n2 - count)
    :task (cook-dish-in-pot ?d ?p)
    :precondition (and
      (recipe ?d ?i ?n2 ?i ?n0)
      (is-zero ?n0)
      (increment ?n0 ?n1)
      (increment ?n1 ?n2)
    )
    :ordered-subtasks (and
      (collect-ingredient-for-pot ?a1 ?p ?i ?n1)
      (collect-ingredient-for-pot ?a2 ?p ?i ?n2)
      (start-cooking-process ?d ?p)
    )
  )

  (:method m-cook-dish-two-different-ingredients
    :parameters (?d - dish ?p - pot ?a1 ?a2 - agent ?i1 ?i2 - ingredient ?n1 ?n2 ?z - count)
    :task (cook-dish-in-pot ?d ?p)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (not (is-zero ?n1))
      (not (is-zero ?n2))
    )
    :ordered-subtasks (and
      (collect-ingredient-for-pot ?a1 ?p ?i1 ?n1)
      (collect-ingredient-for-pot ?a2 ?p ?i2 ?n2)
      (start-cooking-process ?d ?p)
    )
  )

  (:method m-collect-ingredient-zero-done
    :parameters (?a - agent ?p - pot ?i - ingredient ?n - count)
    :task (collect-ingredient-for-pot ?a ?p ?i ?n)
    :precondition (is-zero ?n)
    :subtasks ()
  )

  (:method m-collect-ingredient-one
    :parameters (?a - agent ?p - pot ?i - ingredient ?n1 - count ?n0 - count)
    :task (collect-ingredient-for-pot ?a ?p ?i ?n1)
    :precondition (and
      (increment ?n0 ?n1)
      (is-zero ?n0)
    )
    :ordered-subtasks (and
      (fetch-item ?a ?i)
      (bring-item-to-pot ?a ?p ?i)
    )
  )

  (:method m-collect-ingredient-recursive
    :parameters (?a1 ?a2 - agent ?p - pot ?i - ingredient ?n1 ?n2 - count)
    :task (collect-ingredient-for-pot ?a1 ?p ?i ?n2)
    :precondition (increment ?n1 ?n2)
    :ordered-subtasks (and
      (collect-ingredient-for-pot ?a1 ?p ?i ?n1)
      (fetch-item ?a2 ?i)
      (bring-item-to-pot ?a2 ?p ?i)
    )
  )

  (:method m-fetch-item-from-pile
    :parameters (?a - agent ?item - item ?p - pile ?lp ?la - location ?free - marker)
    :task (fetch-item ?a ?item)
    :precondition (and
      (contains ?p ?item)
      (holding ?a ?free)
      (at ?p ?lp)
      (at ?a ?la)
    )
    :ordered-subtasks (and
      (t-move ?a ?lp)
      (pick-up-from-pile ?a ?p ?lp ?item ?free)
    )
  )

  (:method m-fetch-item-from-table
    :parameters (?a - agent ?item - item ?table - table ?l - location ?free - marker)
    :task (fetch-item ?a ?item)
    :precondition (and
      (holding ?a ?free)
      (holding ?table ?item)
      (reachable ?table ?l)
    )
    :ordered-subtasks (and
      (t-move ?a ?l)
      (pick-up-from-table ?a ?table ?l ?item ?free)
    )
  )

  (:method m-bring-item-to-pot
    :parameters (?a - agent ?p - pot ?i - ingredient ?la ?lp - location ?n1 ?n2 - count ?free - marker ?idle - status)
    :task (bring-item-to-pot ?a ?p ?i)
    :precondition (and
      (holding ?a ?i)
      (at ?a ?la)
      (at ?p ?lp)
      (in-pot ?p ?i ?n1)
      (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (t-move ?a ?lp)
      (add-to-pot ?a ?p ?lp ?i ?n1 ?n2 ?free ?idle)
    )
  )

  (:method m-start-cooking-process
    :parameters (?d - dish ?p - pot ?a - agent ?lp ?la - location ?c0 - count ?i1 ?i2 - ingredient ?n1 ?n2 - count ?free - marker ?idle ?s1 - status)
    :task (start-cooking-process ?d ?p)
    :precondition (and
      (at ?p ?lp)
      (at ?a ?la)
      (holding ?a ?free)
      (pot-status ?p ?idle)
      (idle-status ?idle)
      (cooking-progress ?idle ?s1)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (in-pot ?p ?i1 ?n1)
      (in-pot ?p ?i2 ?n2)
      (is-zero ?c0)
    )
    :ordered-subtasks (and
      (t-move ?a ?lp)
      (start-cook ?a ?p ?lp ?d ?i1 ?i2 ?n1 ?n2 ?c0 ?free ?idle ?s1)
      (finish-cooking ?p ?s1)
    )
  )

  (:method m-finish-cooking-done
    :parameters (?p - pot ?s - status)
    :task (finish-cooking ?p ?s)
    :precondition (and
      (pot-status ?p ?s)
      (finished-status ?s)
    )
    :subtasks ()
  )

  (:method m-finish-cooking-step
    :parameters (?p - pot ?s1 ?s2 - status)
    :task (finish-cooking ?p ?s1)
    :precondition (and
      (pot-status ?p ?s1)
      (cooking-progress ?s1 ?s2)
    )
    :ordered-subtasks (and
      (cook ?p ?s1 ?s2)
      (finish-cooking ?p ?s2)
    )
  )

  (:method m-plate-dish-direct
    :parameters (?a - agent ?p - pot ?d - dish ?b - bowl ?lp - location ?finish ?idle - status)
    :task (plate-dish ?a ?p ?d ?b)
    :precondition (and
      (at ?p ?lp)
      (pot-status ?p ?finish)
      (finished-status ?finish)
      (label-pot-dish ?p ?d)
    )
    :ordered-subtasks (and
      (fetch-item ?a ?b)
      (t-move ?a ?lp)
      (pour-from-pot ?a ?p ?lp ?d ?b ?finish ?idle)
    )
  )

  (:method m-deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery ?la ?ld - location ?free - marker)
    :task (deliver-dish ?a ?d ?del)
    :precondition (and
      (holding ?a ?d)
      (at ?a ?la)
      (at ?del ?ld)
    )
    :ordered-subtasks (and
      (t-move ?a ?ld)
      (drop-off-to-delivery ?a ?del ?ld ?d ?free)
    )
  )

  (:method m-t-move-done
    :parameters (?a - agent ?l - location)
    :task (t-move ?a ?l)
    :precondition (at ?a ?l)
    :subtasks ()
  )

  (:method m-t-move-step
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (t-move ?a ?to)
    :precondition (and
      (at ?a ?from)
      (connect ?from ?mid)
    )
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-move ?a ?to)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)