(define (domain overcooked)

  (:requirements :hierarchy :strips :typing)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  ; ROOT TASK: top-level goal to serve a dish
  (:task t-serve-dish
    :parameters (?dish - dish)
  )

  ; Subtask: fulfill required ingredient count in a pot
  (:task t-fulfill-ingredient
    :parameters (?pot - pot ?i - ingredient ?count - count)
  )

  ; Subtask: add exactly one unit of ingredient to pot
  (:task t-add-one-ingredient
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count)
  )

  ; Subtask: advance pot through cooking until finished
  (:task t-cook-to-finish
    :parameters (?pot - pot ?d - dish)
  )

  ; Subtask: move agent to a target location
  (:task t-get-to
    :parameters (?a - agent ?l - location)
  )

  ; Subtask: agent obtains an item (from pile or table)
  (:task t-get-item
    :parameters (?a - agent ?item - item)
  )

  ; Subtask: agent delivers a prepared dish to delivery zone
  (:task t-deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery ?l - location)
  )

  ; Subtask: pour finished pot contents into bowl to get dish
  (:task t-pour-dish
    :parameters (?a - agent ?pot - pot ?d - dish ?b - bowl)
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-serve-dish
  ; Observed: agents coordinate to pick ingredients, cook, pour, deliver
  ; Generalises: any dish with two ingredients following recipe predicate
  ; -----------------------------------------------------------------------

  ; Method: full pipeline - fulfill both ingredients, cook, pour, deliver
  (:method m-serve-dish-full
    :parameters (?dish - dish
                 ?pot - pot
                 ?i1 ?i2 - ingredient
                 ?n1 ?n2 ?zero - count
                 ?a - agent
                 ?b - bowl
                 ?del - delivery
                 ?dloc - location
                 ?finish ?idle - status)
    :task (t-serve-dish ?dish)
    :precondition (and
      (recipe ?dish ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (in-pot ?pot ?i1 ?zero)
      (in-pot ?pot ?i2 ?zero)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (finished-status ?finish)
      (at ?del ?dloc)
    )
    :ordered-subtasks (and
      (t-fulfill-ingredient ?pot ?i1 ?n1)
      (t-fulfill-ingredient ?pot ?i2 ?n2)
      (t-cook-to-finish ?pot ?dish)
      (t-pour-dish ?a ?pot ?dish ?b)
      (t-deliver-dish ?a ?dish ?del ?dloc)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-fulfill-ingredient
  ; Observed: agents pick onions/tomatoes from piles and add to pot
  ; Generalises: any ingredient with any required count
  ; -----------------------------------------------------------------------

  ; Base case: ingredient already at required count
  (:method m-fulfill-ingredient-done
    :parameters (?pot - pot ?i - ingredient ?count - count)
    :task (t-fulfill-ingredient ?pot ?i ?count)
    :precondition (and
      (in-pot ?pot ?i ?count)
    )
    :ordered-subtasks (and)
  )

  ; Recursive case: add one more unit then recurse
  (:method m-fulfill-ingredient-recurse
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext ?ntarget - count)
    :task (t-fulfill-ingredient ?pot ?i ?ntarget)
    :precondition (and
      (in-pot ?pot ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
      (not (= ?ncurrent ?ntarget))
    )
    :ordered-subtasks (and
      (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
      (t-fulfill-ingredient ?pot ?i ?ntarget)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-add-one-ingredient
  ; Observed: agent picks from pile and adds to pot
  ; Generalises: any agent, any ingredient pile at any location
  ; -----------------------------------------------------------------------

  ; Agent picks from pile and adds to pot at pot location
  (:method m-add-ingredient-from-pile
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count
                 ?a - agent
                 ?pile - pile
                 ?ploc ?potloc - location
                 ?free - marker
                 ?idle - status)
    :task (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
    :precondition (and
      (at ?pile ?ploc)
      (contains ?pile ?i)
      (at ?pot ?potloc)
      (in-pot ?pot ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?ploc)
      (pick-up-from-pile ?a ?pile ?ploc ?i ?free)
      (t-get-to ?a ?potloc)
      (add-to-pot ?a ?pot ?potloc ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  ; Agent picks from table (intermediate) and adds to pot
  ; Tentative: generalises for cases where ingredient placed on table first
  (:method m-add-ingredient-from-table
    :parameters (?pot - pot ?i - ingredient ?ncurrent ?nnext - count
                 ?a - agent
                 ?table - table
                 ?tloc ?potloc - location
                 ?free - marker
                 ?idle - status)
    :task (t-add-one-ingredient ?pot ?i ?ncurrent ?nnext)
    :precondition (and
      (reachable ?table ?tloc)
      (holding ?table ?i)
      (at ?pot ?potloc)
      (in-pot ?pot ?i ?ncurrent)
      (increment ?ncurrent ?nnext)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?tloc)
      (pick-up-from-table ?a ?table ?tloc ?i ?free)
      (t-get-to ?a ?potloc)
      (add-to-pot ?a ?pot ?potloc ?i ?ncurrent ?nnext ?free ?idle)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-cook-to-finish
  ; Observed: pot progresses through cooking states after start-cook
  ; Generalises: any sequence of cooking-progress steps
  ; -----------------------------------------------------------------------

  ; Start cooking then advance to finished state
  (:method m-start-and-cook
    :parameters (?pot - pot ?d - dish
                 ?a - agent ?l - location
                 ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count
                 ?free - marker
                 ?idle ?start ?finish - status)
    :task (t-cook-to-finish ?pot ?d)
    :precondition (and
      (at ?pot ?l)
      (pot-status ?pot ?idle)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (in-pot ?pot ?i1 ?n1)
      (in-pot ?pot ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
      (finished-status ?finish)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (start-cook ?a ?pot ?l ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
      (t-advance-cooking ?pot ?start ?finish)
    )
  )

  ; Subtask: advance cooking states until finished
  (:task t-advance-cooking
    :parameters (?pot - pot ?s1 ?finish - status)
  )

  ; Base: already at finished state
  (:method m-cooking-done
    :parameters (?pot - pot ?s - status)
    :task (t-advance-cooking ?pot ?s ?s)
    :precondition (and
      (pot-status ?pot ?s)
      (finished-status ?s)
    )
    :ordered-subtasks (and)
  )

  ; Recursive: cook one step then continue
  (:method m-cooking-step
    :parameters (?pot - pot ?s1 ?s2 ?finish - status)
    :task (t-advance-cooking ?pot ?s1 ?finish)
    :precondition (and
      (pot-status ?pot ?s1)
      (cooking-progress ?s1 ?s2)
      (not (finished-status ?s1))
    )
    :ordered-subtasks (and
      (cook ?pot ?s1 ?s2)
      (t-advance-cooking ?pot ?s2 ?finish)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-pour-dish
  ; Observed: agent picks bowl then pours pot into bowl to get dish
  ; Generalises: any agent, bowl pile, pot location
  ; -----------------------------------------------------------------------

  ; Agent retrieves bowl from pile then pours at pot location
  (:method m-pour-from-pile-bowl
    :parameters (?a - agent ?pot - pot ?d - dish ?b - bowl
                 ?pile - pile
                 ?ploc ?potloc - location
                 ?free - marker
                 ?finish ?idle - status)
    :task (t-pour-dish ?a ?pot ?d ?b)
    :precondition (and
      (at ?pile ?ploc)
      (contains ?pile ?b)
      (at ?pot ?potloc)
      (pot-status ?pot ?finish)
      (finished-status ?finish)
      (label-pot-dish ?pot ?d)
      (idle-status ?idle)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?ploc)
      (pick-up-from-pile ?a ?pile ?ploc ?b ?free)
      (t-get-to ?a ?potloc)
      (pour-from-pot ?a ?pot ?potloc ?d ?b ?finish ?idle)
    )
  )

  ; Agent retrieves bowl from table then pours (tentative generalisation)
  (:method m-pour-from-table-bowl
    :parameters (?a - agent ?pot - pot ?d - dish ?b - bowl
                 ?table - table
                 ?tloc ?potloc - location
                 ?free - marker
                 ?finish ?idle - status)
    :task (t-pour-dish ?a ?pot ?d ?b)
    :precondition (and
      (reachable ?table ?tloc)
      (holding ?table ?b)
      (at ?pot ?potloc)
      (pot-status ?pot ?finish)
      (finished-status ?finish)
      (label-pot-dish ?pot ?d)
      (idle-status ?idle)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?tloc)
      (pick-up-from-table ?a ?table ?tloc ?b ?free)
      (t-get-to ?a ?potloc)
      (pour-from-pot ?a ?pot ?potloc ?d ?b ?finish ?idle)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-deliver-dish
  ; Observed: agent carries dish to delivery zone
  ; Generalises: any delivery location
  ; -----------------------------------------------------------------------

  (:method m-deliver-dish
    :parameters (?a - agent ?d - dish ?del - delivery ?l - location ?free - marker)
    :task (t-deliver-dish ?a ?d ?del ?l)
    :precondition (and
      (at ?del ?l)
      (holding ?a ?d)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (drop-off-to-delivery ?a ?del ?l ?d ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-get-to
  ; Observed: agents navigate across connected locations
  ; -----------------------------------------------------------------------

  ; Already at target
  (:method m-get-to-done
    :parameters (?a - agent ?l - location)
    :task (t-get-to ?a ?l)
    :precondition (at ?a ?l)
    :ordered-subtasks (and)
  )

  ; Move one step then recurse
  (:method m-get-to-step
    :parameters (?a - agent ?from ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and
      (at ?a ?from)
      (connect ?from ?to)
      (not (= ?from ?to))
    )
    :ordered-subtasks (and
      (move ?a ?from ?to)
    )
  )

  ; Multi-hop: move through intermediate location
  (:method m-get-to-multi
    :parameters (?a - agent ?from ?mid ?to - location)
    :task (t-get-to ?a ?to)
    :precondition (and
      (at ?a ?from)
      (connect ?from ?mid)
      (not (= ?from ?to))
      (not (= ?mid ?to))
    )
    :ordered-subtasks (and
      (move ?a ?from ?mid)
      (t-get-to ?a ?to)
    )
  )

  ; -----------------------------------------------------------------------
  ; METHODS for t-get-item
  ; Observed: agents pick items from piles or tables
  ; -----------------------------------------------------------------------

  ; Get item from pile
  (:method m-get-item-from-pile
    :parameters (?a - agent ?item - item ?pile - pile ?l - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (at ?pile ?l)
      (contains ?pile ?item)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-pile ?a ?pile ?l ?item ?free)
    )
  )

  ; Get item from table
  (:method m-get-item-from-table
    :parameters (?a - agent ?item - item ?table - table ?l - location ?free - marker)
    :task (t-get-item ?a ?item)
    :precondition (and
      (reachable ?table ?l)
      (holding ?table ?item)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (t-get-to ?a ?l)
      (pick-up-from-table ?a ?table ?l ?item ?free)
    )
  )

  ; -----------------------------------------------------------------------
  ; ACTIONS (copied verbatim from PDDL domain)
  ; -----------------------------------------------------------------------

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )

)
