(define (domain overcooked)
  (:requirements :typing :hierarchy :equality)

  (:types
    location
    status count
    agent pile pot delivery - locatable
    ingredient dish bowl marker - item
    agent table - holdable
  )

  (:predicates
    (at ?x - locatable ?l - location)
    (connect ?from ?to - location)
    (reachable ?table - table ?from - location)
    (holding ?a - holdable ?i - item)
    (contains ?p - pile ?i - item)
    (increment ?n1 ?n2 - count)
    (recipe ?d - dish ?i1 - ingredient ?n1 - count ?i2 - ingredient ?n2 - count)
    (in-pot ?p - pot ?i - ingredient ?n - count)
    (pot-status ?p - pot ?s - status)
    (cooking-progress ?s1 ?s2 - status)
    (finished-status ?s - status)
    (idle-status ?s - status)
    (is-zero ?n - count)
    (label-pot-dish ?p - pot ?d - dish)
    (delivered ?d - dish)
  )

  (:task root_serve_dish
    :parameters (?d - dish)
  )

  (:task cook_dish
    :parameters (?p - pot ?d - dish)
  )

  (:task prepare_pot
    :parameters (?p - pot ?d - dish)
  )

  (:task start_cooking
    :parameters (?p - pot ?d - dish)
  )

  (:task wait_cook
    :parameters (?p - pot ?current ?target - status)
  )

  (:task fill_ingredient
    :parameters (?p - pot ?i - ingredient ?current ?target - count)
  )

  (:task get_item
    :parameters (?a - agent ?i - item)
  )

  (:task deliver_dish
    :parameters (?a - agent ?d - dish ?del - delivery ?l_del - location)
  )

  (:task move_to
    :parameters (?a - agent ?to - location)
  )

  (:method serve_dish_method
    :parameters (?d - dish ?p - pot ?a_plate - agent ?l_pot - location ?del - delivery ?l_del - location ?b - bowl ?finish ?idle - status)
    :task (root_serve_dish ?d)
    :precondition (and
      (at ?p ?l_pot)
      (at ?del ?l_del)
      (finished-status ?finish)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (cook_dish ?p ?d)
      (get_item ?a_plate ?b)
      (move_to ?a_plate ?l_pot)
      (pour-from-pot ?a_plate ?p ?l_pot ?d ?b ?finish ?idle)
      (deliver_dish ?a_plate ?d ?del ?l_del)
    )
  )

  (:method cook_dish_method
    :parameters (?p - pot ?d - dish ?idle ?start ?finish - status)
    :task (cook_dish ?p ?d)
    :precondition (and
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
      (finished-status ?finish)
    )
    :ordered-subtasks (and
      (prepare_pot ?p ?d)
      (start_cooking ?p ?d)
      (wait_cook ?p ?start ?finish)
    )
  )

  (:method prepare_pot_method
    :parameters (?p - pot ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?current1 ?current2 - count)
    :task (prepare_pot ?p ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (in-pot ?p ?i1 ?current1)
      (in-pot ?p ?i2 ?current2)
    )
    :ordered-subtasks (and
      (fill_ingredient ?p ?i1 ?current1 ?n1)
      (fill_ingredient ?p ?i2 ?current2 ?n2)
    )
  )

  (:method start_cooking_method
    :parameters (?a - agent ?p - pot ?l_pot - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :task (start_cooking ?p ?d)
    :precondition (and
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (at ?p ?l_pot)
      (is-zero ?zero)
      (idle-status ?idle)
      (cooking-progress ?idle ?start)
    )
    :ordered-subtasks (and
      (move_to ?a ?l_pot)
      (start-cook ?a ?p ?l_pot ?d ?i1 ?i2 ?n1 ?n2 ?zero ?free ?idle ?start)
    )
  )

  (:method wait_cook_done
    :parameters (?p - pot ?s - status)
    :task (wait_cook ?p ?s ?s)
    :precondition ()
    :ordered-subtasks ()
  )

  (:method wait_cook_step
    :parameters (?p - pot ?current ?next ?target - status)
    :task (wait_cook ?p ?current ?target)
    :precondition (and
      (not (= ?current ?target))
      (cooking-progress ?current ?next)
    )
    :ordered-subtasks (and
      (cook ?p ?current ?next)
      (wait_cook ?p ?next ?target)
    )
  )

  (:method fill_ingredient_done
    :parameters (?p - pot ?i - ingredient ?n - count)
    :task (fill_ingredient ?p ?i ?n ?n)
    :precondition ()
    :ordered-subtasks ()
  )

  (:method fill_ingredient_step
    :parameters (?a - agent ?p - pot ?l_pot - location ?i - ingredient ?current ?next ?target - count ?free - marker ?idle - status)
    :task (fill_ingredient ?p ?i ?current ?target)
    :precondition (and
      (not (= ?current ?target))
      (increment ?current ?next)
      (at ?p ?l_pot)
      (idle-status ?idle)
    )
    :ordered-subtasks (and
      (get_item ?a ?i)
      (move_to ?a ?l_pot)
      (add-to-pot ?a ?p ?l_pot ?i ?current ?next ?free ?idle)
      (fill_ingredient ?p ?i ?next ?target)
    )
  )

  (:method get_item_direct
    :parameters (?a - agent ?p_pile - pile ?l_pile - location ?i - item ?free - marker)
    :task (get_item ?a ?i)
    :precondition (and
      (contains ?p_pile ?i)
      (at ?p_pile ?l_pile)
      (holding ?a ?free)
    )
    :ordered-subtasks (and
      (move_to ?a ?l_pile)
      (pick-up-from-pile ?a ?p_pile ?l_pile ?i ?free)
    )
  )

  (:method get_item_collaborative
    :parameters (?a1 ?a2 - agent ?table - table ?p_pile - pile ?l_pile ?l_table1 ?l_table2 - location ?i - item ?free1 ?free2 ?free_table - marker)
    :task (get_item ?a1 ?i)
    :precondition (and
      (not (= ?a1 ?a2))
      (contains ?p_pile ?i)
      (at ?p_pile ?l_pile)
      (holding ?a1 ?free1)
      (holding ?a2 ?free2)
      (holding ?table ?free_table)
      (reachable ?table ?l_table1)
      (reachable ?table ?l_table2)
    )
    :ordered-subtasks (and
      (move_to ?a2 ?l_pile)
      (pick-up-from-pile ?a2 ?p_pile ?l_pile ?i ?free2)
      (move_to ?a2 ?l_table2)
      (drop-off-to-table ?a2 ?table ?l_table2 ?i ?free_table)
      (move_to ?a1 ?l_table1)
      (pick-up-from-table ?a1 ?table ?l_table1 ?i ?free1)
    )
  )

  (:method get_item_from_table
    :parameters (?a - agent ?table - table ?l_table - location ?i - item ?free - marker)
    :task (get_item ?a ?i)
    :precondition (and
      (holding ?table ?i)
      (holding ?a ?free)
      (reachable ?table ?l_table)
    )
    :ordered-subtasks (and
      (move_to ?a ?l_table)
      (pick-up-from-table ?a ?table ?l_table ?i ?free)
    )
  )

  (:method deliver_dish_direct
    :parameters (?a - agent ?d - dish ?del - delivery ?l_del - location ?free - marker)
    :task (deliver_dish ?a ?d ?del ?l_del)
    :precondition (and
      (at ?del ?l_del)
    )
    :ordered-subtasks (and
      (move_to ?a ?l_del)
      (drop-off-to-delivery ?a ?del ?l_del ?d ?free)
    )
  )

  (:method deliver_dish_collaborative
    :parameters (?a1 ?a2 - agent ?d - dish ?del - delivery ?l_del - location ?table - table ?l_table1 ?l_table2 - location ?free_table ?free2 - marker)
    :task (deliver_dish ?a1 ?d ?del ?l_del)
    :precondition (and
      (not (= ?a1 ?a2))
      (at ?del ?l_del)
      (holding ?table ?free_table)
      (holding ?a2 ?free2)
      (reachable ?table ?l_table1)
      (reachable ?table ?l_table2)
    )
    :ordered-subtasks (and
      (move_to ?a1 ?l_table1)
      (drop-off-to-table ?a1 ?table ?l_table1 ?d ?free_table)
      (move_to ?a2 ?l_table2)
      (pick-up-from-table ?a2 ?table ?l_table2 ?d ?free2)
      (move_to ?a2 ?l_del)
      (drop-off-to-delivery ?a2 ?del ?l_del ?d ?free2)
    )
  )

  (:method move_to_done
    :parameters (?a - agent ?to - location)
    :task (move_to ?a ?to)
    :precondition (at ?a ?to)
    :ordered-subtasks ()
  )

  (:method move_to_step
    :parameters (?a - agent ?from ?to ?next - location)
    :task (move_to ?a ?to)
    :precondition (and
      (not (= ?from ?to))
      (at ?a ?from)
      (connect ?from ?next)
    )
    :ordered-subtasks (and
      (move ?a ?from ?next)
      (move_to ?a ?to)
    )
  )

  (:action move
    :parameters (?a - agent ?from ?to - location)
    :precondition (and (at ?a ?from) (connect ?from ?to))
    :effect (and (not (at ?a ?from)) (at ?a ?to))
  )

  (:action pick-up-from-pile
    :parameters (?a - agent ?p - pile ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (at ?p ?l) (holding ?a ?free) (contains ?p ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item))
  )

  (:action pick-up-from-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?free) (holding ?table ?item))
    :effect (and (not (holding ?a ?free)) (holding ?a ?item) (not (holding ?table ?item)) (holding ?table ?free))
  )

  (:action drop-off-to-table
    :parameters (?a - agent ?table - table ?l - location ?item - item ?free - marker)
    :precondition (and (at ?a ?l) (reachable ?table ?l) (holding ?a ?item) (holding ?table ?free))
    :effect (and (not (holding ?table ?free)) (holding ?a ?free) (holding ?table ?item) (not (holding ?a ?item)))
  )

  (:action add-to-pot
    :parameters (?a - agent ?p - pot ?l - location ?i - ingredient ?n1 ?n2 - count ?free - marker ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?i)
      (in-pot ?p ?i ?n1) (increment ?n1 ?n2)
      (pot-status ?p ?idle)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?i)) (holding ?a ?free)
      (not (in-pot ?p ?i ?n1)) (in-pot ?p ?i ?n2)
    )
  )

  (:action start-cook
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?i1 ?i2 - ingredient ?n1 ?n2 ?zero - count ?free - marker ?idle ?start - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?free)
      (pot-status ?p ?idle) (cooking-progress ?idle ?start)
      (in-pot ?p ?i1 ?n1) (in-pot ?p ?i2 ?n2)
      (recipe ?d ?i1 ?n1 ?i2 ?n2)
      (is-zero ?zero)
    )
    :effect (and
      (not (pot-status ?p ?idle)) (pot-status ?p ?start)
      (not (in-pot ?p ?i1 ?n1)) (not (in-pot ?p ?i2 ?n2))
      (in-pot ?p ?i1 ?zero) (in-pot ?p ?i2 ?zero)
      (label-pot-dish ?p ?d)
    )
  )

  (:action cook
    :parameters (?p - pot ?s1 ?s2 - status)
    :precondition (and (pot-status ?p ?s1) (cooking-progress ?s1 ?s2))
    :effect (and (not (pot-status ?p ?s1)) (pot-status ?p ?s2))
  )

  (:action pour-from-pot
    :parameters (?a - agent ?p - pot ?l - location ?d - dish ?b - bowl ?finish ?idle - status)
    :precondition (and
      (at ?a ?l) (at ?p ?l) (holding ?a ?b)
      (pot-status ?p ?finish) (finished-status ?finish)
      (label-pot-dish ?p ?d)
      (idle-status ?idle)
    )
    :effect (and
      (not (holding ?a ?b)) (holding ?a ?d)
      (not (pot-status ?p ?finish)) (pot-status ?p ?idle)
      (not (label-pot-dish ?p ?d))
    )
  )

  (:action drop-off-to-delivery
    :parameters (?a - agent ?del - delivery ?l - location ?d - dish ?free - marker)
    :precondition (and (at ?a ?l) (at ?del ?l) (holding ?a ?d))
    :effect (and (not (holding ?a ?d)) (holding ?a ?free) (delivered ?d))
  )
)